# ============================================================
#  FinanceTracker — .gitignore
#  Blazor WebAssembly + ASP.NET Core + EF Core + SQLite
# ============================================================

# ── Build output ────────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# ── .NET / Visual Studio ────────────────────────────────────
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
_ReSharper*/
*.DotSettings.user
*.ncrunchproject
*.ncrunchsolution

# ── Rider ───────────────────────────────────────────────────
.idea/
*.sln.iml

# ── VS Code ─────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ── EF Core — never commit the dev database ─────────────────
*.db
*.db-shm
*.db-wal

# ── User Secrets (contains JWT secret key, connection strings)
**/secrets.json
**/appsettings.Development.json

# ── NuGet ───────────────────────────────────────────────────
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# ── Blazor WASM publish output ──────────────────────────────
**/wwwroot/_framework/
**/publish/

# ── OS generated ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Test results ────────────────────────────────────────────
TestResults/
*.trx
*.coverage
*.coveragexml
coverage*/

# ── Node (if you add any JS tooling later) ──────────────────
node_modules/
npm-debug.log*

# ── Environment / CI secrets ────────────────────────────────
.env
.env.*
!.env.example