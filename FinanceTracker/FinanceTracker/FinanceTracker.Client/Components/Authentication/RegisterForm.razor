@namespace FinanceTracker.Client.Components.Authentication

<EditForm Model=@_model"
          OnValidSubmit="@HandleSubmit">

    <DataAnnotationsValidator />

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="auth-error"
             role="alert">

            <span class="error-icon">!</span>

            <span>
                @ErrorMessage
            </span>

        </div>
    }

    <div class="form-group">

        <label for="register-name">
            Full name
        </label>

        <InputText id="register-name"
                   class="form-control"
                   @bind-Value="_model.FullName"
                   autocomplete="name"
                   placeholder="Juan dela Cruz" />

        <ValidationMessage For="@(() => _model.FullName)" />

    </div>

    <div class="form-group">

        <label for="register-email">
            Email address
        </label>

        <InputText id="register-email"
                   class="form-control"
                   @bind-Value="_model.Email"
                   autocomplete="email"
                   placeholder="you@email.com" />

        <ValidationMessage For="@(() => _model.Email)" />

    </div>

    <div class="form-group">

        <label for="register-password">
            Password
        </label>

        <InputText id="register-password"
                   class="form-control"
                   type="password"
                   @bind-Value="_model.Password"
                   autocomplete="new-password"
                   placeholder="At least 8 characters" />

        <ValidationMessage For="@(() => _model.Password)" />

    </div>

    <div class="form-group">

        <label for="register-confirm-password">
            Confirm password
        </label>

        <InputText id="register-confirm-password"
                   class="form-control"
                   type="password"
                   @bind-Value="_model.ConfirmPassword"
                   autocomplete="new-password"
                   placeholder="Repeat your password" />

        <ValidationMessage For="@(() => _model.ConfirmPassword)" />

    </div>

    <button class="submit-button"
            type="submit"
            disabled="@IsLoading">

        @if (IsLoading)
        {
            <span class="loading-spinner"></span>
            <span>Creating account...</span>
        }
        else
        {
            <span>Create account</span>
            <span class="button-arrow">→</span>
        }

    </button>

    <p class="auth-switch">

        Already have an account?

        <a href="/login">
            Sign in
        </a>

    </p>

</EditForm>

@code {

    private RegisterDto _model = new();

    [Parameter]
    public EventCallback<RegisterDto> OnSubmit { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync(_model);
    }

}
