@namespace FinanceTracker.Client.Components.Transactions

<div class="transaction-panel">

    @if (!Transactions.Any())
    {
        <div class="empty-state">

            <div class="empty-icon">
                💸
            </div>

            <h3>No transactions found</h3>

            <p>
                Try changing your search or add a new transaction.
            </p>

        </div>
    }
    else
    {
        <div class="transaction-table">

            <div class="table-header">

                <span>Description</span>
                <span>Category</span>
                <span>Date</span>
                <span>Amount</span>
                <span></span>

            </div>

            @foreach (var transaction in Transactions)
            {
                <TransactionRow
                    Transaction="@transaction"
                    OnEdit="@OnEdit"
                    OnDelete="@OnDelete" />
            }

        </div>
    }

</div>

@code {

    [Parameter]
    public IEnumerable<TransactionDto> Transactions { get; set; } = Enumerable.Empty<TransactionDto>();

    [Parameter]
    public EventCallback<TransactionDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<TransactionDto> OnDelete { get; set; }

}
