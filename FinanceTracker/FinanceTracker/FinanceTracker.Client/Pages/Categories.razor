@page "/categories"
@attribute [Authorize]

@inject CategoryService CategoryService

<div class="categories-page">

    <header class="page-header">

        <div>
            <h1>Categories</h1>

            <p>
                Organise your transactions and budgets.
            </p>
        </div>

        <button class="primary-button"
                @onclick="OpenAddModal">

            <span>＋</span>
            Add category

        </button>

    </header>

    <LoadingWrapper IsLoading="@_isLoading"
                    Message="Loading your categories...">

        @if (!_categories.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    🏷️
                </div>

                <h3>No categories yet</h3>

                <p>
                    Create your first category to start organising
                    your transactions.
                </p>

                <button class="primary-button"
                        @onclick="OpenAddModal">

                    Add your first category

                </button>

            </div>
        }
        else
        {
            <CategoryList Categories="@_categories"
                          OnEdit="OpenEditModal"
                          OnDelete="HandleDelete" />
        }

    </LoadingWrapper>

</div>

@if (_showModal)
{
    <div class="modal-backdrop"
         @onclick="CloseModal">

        <div class="modal-box"
             @onclick:stopPropagation>

            <div class="modal-header">

                <div>
                    <h2>
                        @(_editingCategory is null
                            ? "Add category"
                            : "Edit category")
                    </h2>

                    <p>
                        @(_editingCategory is null
                            ? "Create a category for your transactions."
                            : "Update your category details.")
                    </p>
                </div>

                <button class="modal-close"
                        type="button"
                        @onclick="CloseModal">

                    ×

                </button>

            </div>

            <CategoryForm Model="@_formModel"
                          IsLoading="@_isSaving"
                          ErrorMessage="@_error"
                          OnSave="HandleSave"
                          OnCancel="CloseModal" />

        </div>

    </div>
}

@code {

    private bool _isLoading = true;
    private bool _showModal;
    private bool _isSaving;

    private string? _error;

    private List<CategoryDto> _categories = new();

    private CategoryDto? _editingCategory;

    private SaveCategoryDto _formModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        _isLoading = true;

        try
        {
            _categories = await CategoryService.GetAllAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        _editingCategory = null;
        _formModel = new SaveCategoryDto();
        _error = null;
        _showModal = true;
    }

    private void OpenEditModal(CategoryDto category)
    {
        _editingCategory = category;

        _formModel = new SaveCategoryDto
        {
            Name = category.Name,
            Color = category.Color,
            Icon = category.Icon
        };

        _error = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _editingCategory = null;
        _error = null;
    }

    private async Task HandleSave(SaveCategoryDto dto)
    {
        _isSaving = true;
        _error = null;

        try
        {
            var success = _editingCategory is null
                ? await CategoryService.CreateAsync(dto)
                : await CategoryService.UpdateAsync(
                    _editingCategory.Id,
                    dto);

            if (success is not null)
            {
                CloseModal();
                await LoadCategoriesAsync();
            }
            else
            {
                _error = "Failed to save category. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to save category: {ex.Message}");
            _error = "Something went wrong. Please try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task HandleDelete(CategoryDto category)
    {
        var response = await CategoryService.DeleteAsync(category.Id);

        if (response.IsSuccessStatusCode)
        {
            _categories.Remove(category);
        }
    }
}