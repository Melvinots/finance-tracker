@page "/register"
@layout AuthLayout

@inject AuthService AuthService
@inject NavigationManager Navigation

<FormCard>

    <Header>
        <h2>Create your account</h2>
        <p>Start building better financial habits today.</p>
    </Header>

    <ChildContent>

        <RegisterForm OnSubmit="HandleRegister"
                      ErrorMessage="@_error"
                      IsLoading="@_isLoading" />

    </ChildContent>

</FormCard>

@code {

    private string? _error;

    private bool _isLoading;

    private async Task HandleRegister(RegisterDto model)
    {
        _isLoading = true;
        _error = null;

        var error = await AuthService.RegisterAsync(model);

        if (error is null)
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        _error = error;
        _isLoading = false;
    }

}
