@namespace FinanceTracker.Client.Components

<div class="landing-page">

    <!-- Navigation -->
    <header class="landing-nav">

        <a href="/" class="brand">

            <span class="brand-mark">
                ₱
            </span>

            <span class="brand-name">
                Finance Tracker
            </span>

        </a>

        <nav class="nav-actions">

            <a href="/login"
                   class="nav-login">
                Sign in
            </a>

        </nav>

    </header>


    <!-- Hero -->
    <main>

        <section class="hero-section">

            <div class="hero-content">

                <div class="hero-eyebrow">

                    <span class="eyebrow-dot"></span>

                    YOUR MONEY, YOUR CLARITY

                </div>

                <h1>

                    Know where your money
                    <span>actually goes.</span>

                </h1>

                <p class="hero-description">

                    A simpler way to understand your finances.
                    Track your income, manage your spending, and
                    build better financial habits — all in one place.

                </p>

                <div class="hero-actions">

                    <a href="/register"
                           class="button button-primary">

                        Start tracking for free

                        <span>→</span>

                    </a>

                    <a href="/login"
                           class="button button-secondary">

                        Sign in

                    </a>

                </div>

                <div class="hero-note">

                    <span class="note-check">✓</span>

                    Simple. Private. Built for your everyday finances.

                </div>

            </div>


            <!-- Dashboard Preview -->
            <div class="hero-visual">

                <DashboardPreview />

            </div>

        </section>


        <!-- Feature Strip -->
        <section class="feature-strip">

            <div class="feature-strip-item">

                <div class="feature-strip-number">
                    01
                </div>

                <div class="feature-strip-icon">
                    ↗
                </div>

                <div class="feature-strip-content">

                    <strong>
                        Track everything
                    </strong>

                    <span>
                        Know exactly where your money goes.
                    </span>

                </div>

            </div>


            <div class="feature-strip-item">

                <div class="feature-strip-number">
                    02
                </div>

                <div class="feature-strip-icon">
                    ◷
                </div>

                <div class="feature-strip-content">

                    <strong>
                        Understand your habits
                    </strong>

                    <span>
                        See patterns in your everyday spending.
                    </span>

                </div>

            </div>


            <div class="feature-strip-item">

                <div class="feature-strip-number">
                    03
                </div>

                <div class="feature-strip-icon">
                    ✓
                </div>

                <div class="feature-strip-content">

                    <strong>
                        Plan with confidence
                    </strong>

                    <span>
                        Make decisions with a clearer financial picture.
                    </span>

                </div>

            </div>

        </section>


        <!-- Features -->
        <section class="features-section">

            <div class="section-heading">

                <span class="section-eyebrow">
                    A BETTER WAY TO MANAGE MONEY
                </span>

                <h2>
                    Financial clarity
                    <span>without the complexity.</span>
                </h2>

                <p>
                    Everything you need to build a clearer picture
                    of where your money goes.
                </p>

            </div>


            <div class="features-grid">

                <article class="feature-card feature-card-large">

                    <div class="feature-number">
                        01
                    </div>

                    <div class="feature-icon">
                        ↗
                    </div>

                    <h3>
                        See where your money goes.
                    </h3>

                    <p>
                        Organize your income and expenses into a clear,
                        easy-to-understand overview of your financial life.
                    </p>

                </article>


                <article class="feature-card">

                    <div class="feature-number">
                        02
                    </div>

                    <div class="feature-icon">
                        ◷
                    </div>

                    <h3>
                        Stay ahead of your spending.
                    </h3>

                    <p>
                        Set budgets and monitor your progress before
                        small expenses become big surprises.
                    </p>

                </article>


                <article class="feature-card">

                    <div class="feature-number">
                        03
                    </div>

                    <div class="feature-icon">
                        ✓
                    </div>

                    <h3>
                        Build better habits.
                    </h3>

                    <p>
                        Consistent awareness makes it easier to make
                        better financial decisions over time.
                    </p>

                </article>

            </div>

        </section>


        <!-- CTA -->
        <section class="cta-section">

            <div class="cta-content">

                <span class="section-eyebrow">
                    START TODAY
                </span>

                <h2>
                    Your financial future
                    starts with clarity.
                </h2>

                <p>
                    Take the first step toward understanding your money better.
                </p>

                <a href="/register"
                       class="button button-light">

                    Create your free account

                    <span>→</span>

                </a>

            </div>

        </section>

    </main>
    

</div>
