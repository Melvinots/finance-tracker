@namespace FinanceTracker.Client.Components.Categories

<div class="modal-backdrop">

    <div class="modal-box">

        <div class="modal-header">

            <div>
                <h2>
                    @(Category is null
                        ? "Add category"
                        : "Edit category")
                </h2>

                <p>
                    @(Category is null
                        ? "Create a category for your transactions."
                        : "Update your category details.")
                </p>
            </div>

            <button class="modal-close"
                    type="button"
                    @onclick="HandleCancel">

                <Blazicon Svg="Lucide.X" />

            </button>

        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="form-error">
                <Blazicon Svg="Lucide.CircleAlert" />
                <span>@ErrorMessage</span>
            </div>
        }

        <div class="form-group">

            <label>
                Icon
            </label>

            <div class="icon-picker">

                @foreach (var icon in _icons)
                {
                    <button type="button"
                            class="icon-button @(_model.Icon == icon.Name ? "selected" : "")"
                            style="--icon-color: @_model.Color"
                            aria-label="Select @icon.Name icon"
                            aria-pressed="@(_model.Icon == icon.Name)"
                            @onclick="() => SelectIcon(icon.Name)">

                        <Blazicon Svg="@icon.Icon" />

                    </button>
                }

            </div>

        </div>


        <div class="form-group">

            <label for="category-name">
                Name
            </label>

            <InputText id="category-name"
                       class="form-input"
                       @bind-Value="_model.Name"
                       placeholder="e.g. Food, Transport, Utilities..." />

            <ValidationMessage For="@(() => _model.Name)" />

        </div>


        <div class="form-group">

            <label>
                Color
            </label>

            <div class="color-picker">

                @foreach (var color in _colors)
                {
                    <button type="button"
                            class="color-button @(_model.Color == color ? "selected" : "")"
                            style="--color: @color"
                            aria-label="Select color @color"
                            aria-pressed="@(_model.Color == color)"
                            @onclick="() => SelectColor(color)">
                    </button>
                }

            </div>

        </div>


        <div class="category-preview">

            <span class="preview-label">
                Preview
            </span>

            <div class="preview-category"
                 style="--category-color: @_model.Color; --category-color-soft: @(_model.Color + "18");">

                <div class="preview-icon">
                    <Blazicon Svg="@GetIcon(_model.Icon)" />
                </div>

                <span>
                    @(string.IsNullOrWhiteSpace(_model.Name)
                        ? "Category name"
                        : _model.Name)
                </span>

            </div>

        </div>

        <footer class="modal-actions">

            <button type="button"
                    class="cancel-button"
                    @onclick="HandleCancel"
                    disabled="@IsLoading">

                Cancel

            </button>

            <button type="submit"
                    class="save-button"
                    @onclick="HandleSubmit"
                    disabled="@IsLoading">

                @if (IsLoading)
                {
                    <span class="loading-spinner"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <Blazicon Svg="Lucide.Check" />
                    <span>Save category</span>
                }

            </button>

        </footer>

    </div>

</div>

@code {

    [Parameter]
    public CategoryDto? Category { get; set; } = new();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback<SaveCategoryDto> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    public SaveCategoryDto _model = new();

    protected override void OnParametersSet()
    {
        _model = new SaveCategoryDto
        {
            Name = Category?.Name ?? "",
            Color = Category?.Color ?? "",
            Icon = Category?.Icon ?? ""
        };
    }

    private readonly List<CategoryIcon> _icons = new() 
    { 
        new("Shopping", Lucide.ShoppingCart),
        new("Transport", Lucide.Bus),
        new("Utilities", Lucide.Zap),
        new("Entertainment", Lucide.Film),
        new("Health", Lucide.HeartPulse),
        new("Home", Lucide.House),
        new("Clothing", Lucide.Shirt),
        new("Education", Lucide.BookOpen),
        new("Food", Lucide.Utensils),
        new("Travel", Lucide.Plane),
        new("Work", Lucide.Briefcase),
        new("Gaming", Lucide.Gamepad2),
        new("Medicine", Lucide.Pill),
        new("Pets", Lucide.PawPrint),
        new("Gifts", Lucide.Gift),
        new("Other", Lucide.Inbox)
    };

    private readonly Dictionary<string, SvgIcon> _iconMap = new()
    {
        ["Shopping"] = Lucide.ShoppingCart,
        ["Transport"] = Lucide.Bus,
        ["Utilities"] = Lucide.Zap,
        ["Entertainment"] = Lucide.Film,
        ["Health"] = Lucide.HeartPulse,
        ["Home"] = Lucide.House,
        ["Clothing"] = Lucide.Shirt,
        ["Education"] = Lucide.BookOpen,
        ["Food"] = Lucide.Utensils,
        ["Travel"] = Lucide.Plane,
        ["Work"] = Lucide.Briefcase,
        ["Gaming"] = Lucide.Gamepad2,
        ["Medicine"] = Lucide.Pill,
        ["Pets"] = Lucide.PawPrint,
        ["Gifts"] = Lucide.Gift,
        ["Other"] = Lucide.Inbox
    };

    private SvgIcon GetIcon(string? iconName)
    {
        return iconName is not null && _iconMap.TryGetValue(iconName, out var icon)
            ? icon
            : Lucide.Inbox;
    }

    private readonly List<string> _colors = new()
    {
        "#EF4444", // Red
        "#F97316", // Orange
        "#F59E0B", // Amber
        "#EAB308", // Yellow
        "#84CC16", // Lime
        "#22C55E", // Green
        "#10B981", // Emerald
        "#14B8A6", // Teal
        "#06B6D4", // Cyan
        "#0EA5E9", // Sky
        "#3B82F6", // Blue
        "#8B5CF6", // Violet
        "#A855F7", // Purple
        "#EC4899", // Pink
        "#64748B"  // Slate (for "Other"/misc)
    };

    private void SelectIcon(string icon)
    {
        _model.Icon = icon;
    }

    private void SelectColor(string color)
    {
        _model.Color = color;
    }

    private async Task HandleSubmit()
    {
        await OnSave.InvokeAsync(_model);
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync(_model);
    }

    private record CategoryIcon(
        string Name,
        SvgIcon Icon
    );

}
