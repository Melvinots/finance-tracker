@namespace FinanceTracker.Client.Components.Categories

<EditForm Model="@Model" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="form-error">⚠ @ErrorMessage</div>
    }

    <div class="form-group">
        <label>Icon</label>
        <div class="emoji-picker">
            @foreach (var emoji in _emojis)
            {
                <button type="button"
                        class="emoji-btn @(Model.Icon == emoji ? "selected" : "")"
                        @onclick="() => Model.Icon = emoji">
                    @emoji
                </button>
            }
        </div>
    </div>

    <div class="form-group">
        <label>Name</label>
        <InputText class="form-control"
                   @bind-Value="Model.Name"
                   placeholder="e.g. Food, Transport..." />
        <ValidationMessage For="@(() => Model.Name)" />
    </div>

    <div class="form-group">
        <label>Color</label>
        <div class="color-picker">
            @foreach (var color in _colors)
            {
                <button type="button"
                        class="color-btn @(Model.Color == color ? "selected" : "")"
                        style="background: @color"
                        @onclick="() => Model.Color = color">
                </button>
            }
        </div>
    </div>

    <div class="preview-row">
        <span class="preview-label">Preview</span>
        <div class="preview-chip" style="background: @(Model.Color + "20")">
            <span>@Model.Icon</span>
            <span style="color: @Model.Color; font-weight: 600; font-size: 0.825rem">
                @(string.IsNullOrEmpty(Model.Name) ? "Category name" : Model.Name)
            </span>
        </div>
    </div>

    <div class="form-actions">
        <button type="button" class="btn-cancel" @onclick="OnCancel">
            Cancel
        </button>
        <button type="submit" class="btn-save" disabled="@IsLoading">
            @if (IsLoading)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            @(IsLoading ? "Saving..." : "Save category")
        </button>
    </div>

</EditForm>

@code {

    [Parameter]
    public SaveCategoryDto Model { get; set; } = new();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback<SaveCategoryDto> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private readonly List<string> _emojis = new()
    {
        "🛒", "🚌", "⚡", "🎬", "🏥", "🏠", "👕", "📚",
        "🍔", "✈️", "💼", "🎮", "💊", "🐾", "🎁", "📁"
    };

    private readonly List<string> _colors = new()
    {
        "#3B5BDB", "#10B981", "#F59E0B", "#F43F5E",
        "#8B5CF6", "#06B6D4", "#EC4899", "#64748B",
        "#059669", "#DC2626", "#D97706", "#7C3AED"
    };

    private async Task HandleSubmit()
    {
        await OnSave.InvokeAsync(Model);
    }

}