@namespace FinanceTracker.Client.Components.Categories

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="form-error">
        <Blazicon Svg="Lucide.CircleAlert" />
        <span>@ErrorMessage</span>
    </div>
}

<div class="form-group">

    <label>
        Icon
    </label>

    <div class="icon-picker">

        @foreach (var icon in _icons)
        {
            <button type="button"
                    class="icon-button @(Model.Icon == icon.Name ? "selected" : "")"
                    aria-label="Select @icon.Name icon"
                    aria-pressed="@(Model.Icon == icon.Name)"
                    @onclick="() => SelectIcon(icon.Name)">

                <Blazicon Svg="@icon.Icon" />

            </button>
        }

    </div>

</div>


<div class="form-group">

    <label for="category-name">
        Name
    </label>

    <InputText id="category-name"
               class="form-input"
               @bind-Value="Model.Name"
               placeholder="e.g. Food, Transport, Utilities..." />

    <ValidationMessage For="@(() => Model.Name)" />

</div>


<div class="form-group">

    <label>
        Color
    </label>

    <div class="color-picker">

        @foreach (var color in _colors)
        {
            <button type="button"
                    class="color-button @(Model.Color == color ? "selected" : "")"
                    style="--color: @color"
                    aria-label="Select color @color"
                    aria-pressed="@(Model.Color == color)"
                    @onclick="() => SelectColor(color)">
            </button>
        }

    </div>

</div>


<div class="category-preview">

    <span class="preview-label">
        Preview
    </span>

    <div class="preview-category"
         style="--category-color: @Model.Color;
        --category-color-soft: @(Model.Color + "18");">

        <div class="preview-icon">
            <Blazicon Svg="@GetIcon(Model.Icon)" />
        </div>

        <span>
            @(string.IsNullOrWhiteSpace(Model.Name)
                ? "Category name"
                : Model.Name)
        </span>

    </div>

</div>


<div class="form-actions">

    <button type="button"
            class="cancel-button"
            @onclick="HandleCancel"
            disabled="@IsLoading">

        Cancel

    </button>

    <button type="submit"
            class="save-button"
            @onclick="HandleSubmit"
            disabled="@IsLoading">

        @if (IsLoading)
        {
            <span class="loading-spinner"></span>
            <span>Saving...</span>
        }
        else
        {
            <Blazicon Svg="Lucide.Check" />
            <span>Save category</span>
        }

    </button>

</div>

@code {

    [Parameter]
    public SaveCategoryDto Model { get; set; } = new();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback<SaveCategoryDto> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private readonly List<CategoryIcon> _icons =
    new() { new("Shopping", Lucide.ShoppingCart),
            new("Transport", Lucide.Bus),
            new("Utilities", Lucide.Zap),
            new("Entertainment", Lucide.Film),
            new("Health", Lucide.HeartPulse),
            new("Home", Lucide.House),
            new("Clothing", Lucide.Shirt),
            new("Education", Lucide.BookOpen),
            new("Food", Lucide.Utensils),
            new("Travel", Lucide.Plane),
            new("Work", Lucide.Briefcase),
            new("Gaming", Lucide.Gamepad2),
            new("Medicine", Lucide.Pill),
            new("Pets", Lucide.PawPrint),
            new("Gifts", Lucide.Gift),
            new("Other", Lucide.Inbox) };

    private readonly Dictionary<string, SvgIcon> _iconMap = new()
    {
        ["Shopping"] = Lucide.ShoppingCart,
        ["Transport"] = Lucide.Bus,
        ["Utilities"] = Lucide.Zap,
        ["Entertainment"] = Lucide.Film,
        ["Health"] = Lucide.HeartPulse,
        ["Home"] = Lucide.House,
        ["Clothing"] = Lucide.Shirt,
        ["Education"] = Lucide.BookOpen,
        ["Food"] = Lucide.Utensils,
        ["Travel"] = Lucide.Plane,
        ["Work"] = Lucide.Briefcase,
        ["Gaming"] = Lucide.Gamepad2,
        ["Medicine"] = Lucide.Pill,
        ["Pets"] = Lucide.PawPrint,
        ["Gifts"] = Lucide.Gift,
        ["Other"] = Lucide.Inbox
    };

    private SvgIcon GetIcon(string? iconName)
    {
        return iconName is not null && _iconMap.TryGetValue(iconName, out var icon)
            ? icon
            : Lucide.Inbox;
    }


    private readonly List<string> _colors = new()
    {
        "#3B5BDB",
        "#10B981",
        "#F59E0B",
        "#F43F5E",
        "#8B5CF6",
        "#06B6D4",
        "#EC4899",
        "#64748B",
        "#059669",
        "#DC2626",
        "#D97706",
        "#7C3AED"
    };


    private void SelectIcon(string icon)
    {
        Model.Icon = icon;
    }


    private void SelectColor(string color)
    {
        Model.Color = color;
    }


    private async Task HandleSubmit()
    {
        await OnSave.InvokeAsync(Model);
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync(Model);
    }

    private record CategoryIcon(
        string Name,
        SvgIcon Icon
    );

}