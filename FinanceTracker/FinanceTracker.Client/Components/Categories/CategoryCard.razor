@namespace FinanceTracker.Client.Components.Categories

<div class="category-card"
     style="--category-color: @Category.Color;
    --category-color-soft: @(Category.Color + "18");">

    <div class="category-content">

        <div class="category-icon">
            <Blazicon Svg="@Icons.Category(Category.Icon)" />
        </div>

        <div class="category-info">

            <span class="category-name">
                @Category.Name
            </span>

            <span class="category-meta">
                Category
            </span>

        </div>

    </div>

    <div class="category-actions">

        <button type="button"
                class="action-button"
                title="Edit category"
                aria-label="Edit @Category.Name"
                @onclick="@HandleEdit">

            <Blazicon Svg="Lucide.Pencil" />

        </button>

        <button type="button"
                class="action-button delete"
                title="Delete category"
                aria-label="Delete @Category.Name"
                @onclick="@HandleDelete">

            <Blazicon Svg="Lucide.Trash2" />

        </button>

    </div>

</div>

@code {

    [Parameter]
    public CategoryDto Category { get; set; } = default!;

    [Parameter]
    public EventCallback<CategoryDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<CategoryDto> OnDelete { get; set; }

    private Task HandleEdit()
    {
        return OnEdit.InvokeAsync(Category);
    }

    private Task HandleDelete()
    {
        return OnDelete.InvokeAsync(Category);
    }

}
