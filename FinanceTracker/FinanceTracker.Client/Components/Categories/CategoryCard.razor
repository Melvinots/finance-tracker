@namespace FinanceTracker.Client.Components.Categories

<div class="category-card">

    <div class="category-card-left">
        <div class="category-icon-wrap" style="background: @ColorWithOpacity">
            <span class="category-icon">@Category.Icon</span>
        </div>
        <div class="category-info">
            <div class="category-name">@Category.Name</div>
            <div class="category-color-strip" style="background: @Category.Color"></div>
        </div>
    </div>

    <div class="category-card-actions">
        <button class="action-btn edit-btn" @onclick="() => OnEdit.InvokeAsync(Category)">
            ✏️
        </button>
        <button class="action-btn delete-btn" @onclick="() => OnDelete.InvokeAsync(Category)">
            🗑️
        </button>
    </div>

</div>

@code {

    [Parameter]
    public CategoryDto Category { get; set; } = default!;

    [Parameter]
    public EventCallback<CategoryDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<CategoryDto> OnDelete { get; set; }

    private string ColorWithOpacity => Category.Color + "20";

}