@namespace FinanceTracker.Client.Components.Dashboard

@using Radzen.Blazor

<Card>

    <Header>

        <div class="card-heading">

            <div>

                <h2>Spending by Category</h2>

                <p>Distribution of expenses this month</p>

            </div>

        </div>

    </Header>

    <ChildContent>

        @if (Categories.Any())
        {
            <div class="chart-container">

                <RadzenChart Style="height:100%; width:100%;">

                    <RadzenDonutSeries Data="@Categories"
                                       CategoryProperty="Name"
                                       ValueProperty="Amount" />

                    <RadzenLegend Position="LegendPosition.Right" />

                </RadzenChart>

            </div>
        }
        else
        {
            <div class="empty-state">
                No spending data available.
            </div>
        }

    </ChildContent>

</Card>

@code {

    [Parameter]
    public IEnumerable<CategorySpendingDto> Categories { get; set; } = Enumerable.Empty<CategorySpendingDto>();

}