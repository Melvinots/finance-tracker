@namespace FinanceTracker.Client.Components.Dashboard

<Card>

    <Header>

        <div class="card-heading">

            <div>
                <h2>Budget Progress</h2>
                <p>Track your spending against your budgets</p>
            </div>

            <a href="/budgets" class="view-all">
                Manage <span class="view-all-arrow">→</span>
            </a>

        </div>

    </Header>

    <ChildContent>

        @if (Budgets.Count == 0)
        {
            <div class="empty-state">
                <p>No budgets found for this month.</p>

                <a href="/budgets" class="empty-state-cta">
                    Create a budget <span class="view-all-arrow">→</span>
                </a>
            </div>
        }
        else
        {
            <div class="budget-list">

                @foreach (var budget in Budgets)
                {
                    <div class="budget-item">

                        <div class="budget-item-header">

                            <span class="budget-name">

                                @budget.Category

                                @if (budget.IsOver)
                                {
                                    <span class="badge-over">
                                        Over
                                    </span>
                                }

                            </span>

                            <span class="budget-amounts">

                                @CurrencyFormatter.Format(budget.Spent, CurrencyCode)
                                /
                                @CurrencyFormatter.Format(budget.Limit, CurrencyCode)

                            </span>

                        </div>

                        <div class="budget-bar-background">

                            <div class="budget-bar-fill
                                @(budget.IsOver ? "budget-over" : budget.Percentage >= 80 ? "budget-warning" : "")"
                                 style="--fill: @Math.Min(budget.Percentage, 100)%;">
                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </ChildContent>

</Card>

@code {

    [Parameter]
    public List<BudgetProgressDto> Budgets { get; set; } = new();

    [Parameter]
    public string CurrencyCode { get; set; } = string.Empty;

}