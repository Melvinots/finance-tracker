@namespace FinanceTracker.Client.Components.Dashboard

<div class="panel">

    <div class="panel-header">

        <div>
            <h2 class="panel-title">
                Budget progress
            </h2>

            <p class="panel-subtitle">
                Track your spending against your budgets
            </p>
        </div>

        <a class="panel-link"
           href="/budgets">
            Manage →
        </a>

    </div>

    @if (Budgets.Count == 0)
    {
        <div class="empty-state">
            <p>No budgets found for this month.</p>

            <a href="/budgets">
                Create a budget
            </a>
        </div>
    }
    else
    {
        <div class="budget-list">

            @foreach (var budget in Budgets)
            {
                <div class="budget-item">

                    <div class="budget-item-header">

                        <span class="budget-name">

                            @budget.Category

                            @if (budget.IsOver)
                            {
                                <span class="badge-over">
                                    Over
                                </span>
                            }

                        </span>

                        <span class="budget-amounts">

                            ₱@budget.Spent.ToString("N0")
                            /
                            ₱@budget.Limit.ToString("N0")

                        </span>

                    </div>

                    <div class="budget-bar-background">

                        <div class="budget-bar-fill
                            @(budget.IsOver
                                                             ? "budget-over"
                                                             : budget.Percentage >= 80
                                                                 ? "budget-warning"
                                                                 : "")"
                             style="
                            width: @Math.Min(
                                                                                             budget.Percentage,
                                                                                             100
                                                                                         )%;
                            ">
                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

@code {

    [Parameter]
    public List<BudgetProgressDto> Budgets { get; set; } = new();

}