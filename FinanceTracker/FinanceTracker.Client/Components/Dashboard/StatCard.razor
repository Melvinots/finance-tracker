@namespace FinanceTracker.Client.Components.Dashboard

<div class="stat-card">

    <div class="stat-card-header">

        <span class="stat-card-label">
            @Title
        </span>

        <div class="stat-card-icon"
             style="--icon-bg: @IconBackground">

            <Blazicon Svg="@Icon" />

        </div>

    </div>

    <div class="stat-card-value">
        @Value
    </div>

    <div class="stat-card-trend @Variant.ToLowerInvariant()">
        <span class="stat-card-trend-arrow"></span>
        @Trend
    </div>

</div>

@code {

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public SvgIcon? Icon { get; set; }

    [Parameter]
    public string IconBackground { get; set; } = string.Empty;

    [Parameter]
    public string Variant { get; set; } = "default";

    [Parameter]
    public string Trend { get; set; } = string.Empty;

}