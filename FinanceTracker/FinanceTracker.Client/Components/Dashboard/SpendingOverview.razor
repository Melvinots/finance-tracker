@namespace FinanceTracker.Client.Components.Dashboard

<Card>

    <Header>

        <div class="card-heading">

            <div class="card-title-group">

                <h2>Spending Overview</h2>

                <p>Track your spending over time</p>

            </div>

            <select class="period-select"
                    @bind="selectedPeriod"
                    @bind:after="UpdateChart">

                <option value="@SpendingPeriod.Last3Months">
                    Last 3 Months
                </option>

                <option value="@SpendingPeriod.Last6Months">
                    Last 6 Months
                </option>

                <option value="@SpendingPeriod.Last9Months">
                    Last 9 Months
                </option>

                <option value="@SpendingPeriod.Last12Months">
                    Last 12 Months
                </option>

            </select>

        </div>

    </Header>

    <ChildContent>

        <div class="chart-scroll-wrapper">
            <div class="chart-container">

                <RadzenChart>

                    <RadzenColumnSeries Data="@chartData"
                                        CategoryProperty="Month"
                                        ValueProperty="Income"
                                        Title="Income" />

                    <RadzenColumnSeries Data="@chartData"
                                        CategoryProperty="Month"
                                        ValueProperty="Expenses"
                                        Title="Expenses" />

                    <RadzenCategoryAxis Padding="20" />

                    <RadzenValueAxis>
                        <RadzenGridLines Visible="true"
                                         Stroke="#E2E8F0" />
                        <RadzenAxisTitle Text="@($"Amount ({CurrencyCode})")" />
                    </RadzenValueAxis>

                    <RadzenChartTooltipOptions Shared="true" />

                    <RadzenLegend Visible="true"
                                  Position="LegendPosition.Bottom" />

                </RadzenChart>

            </div>
        </div>

    </ChildContent>

</Card>

@code {

    [Parameter]
    public List<MonthlySpendingDto> Data { get; set; } = new();

    [Parameter]
    public string SelectedMonth { get; set; } = string.Empty;

    [Parameter]
    public string CurrencyCode { get; set; } = string.Empty;

    private SpendingPeriod selectedPeriod = SpendingPeriod.Last6Months;

    private IEnumerable<MonthlySpendingDto> chartData = Enumerable.Empty<MonthlySpendingDto>();

    protected override void OnParametersSet()
    {
        UpdateChart();
    }

    private void UpdateChart()
    {
        if (string.IsNullOrWhiteSpace(SelectedMonth))
        {
            chartData = Enumerable.Empty<MonthlySpendingDto>();
            return;
        }

        if (!DateTime.TryParseExact(SelectedMonth, "yyyy-MM", CultureInfo.InvariantCulture, DateTimeStyles.None, out var selectedDate))
        {
            chartData = Enumerable.Empty<MonthlySpendingDto>();
            return;
        }

        var monthCount = selectedPeriod switch
        {
            SpendingPeriod.Last3Months => 3,
            SpendingPeriod.Last6Months => 6,
            SpendingPeriod.Last9Months => 9,
            SpendingPeriod.Last12Months => 12,
            _ => 6
        };

        var startMonth = new DateTime(selectedDate.Year, selectedDate.Month, 1)
                            .AddMonths(-(monthCount - 1));

        chartData = Data
            .Where(x =>
            {
                var itemMonth = new DateTime(x.Year, x.MonthNumber, 1);
                return itemMonth >= startMonth && itemMonth <= selectedDate;
            })
            .OrderBy(x => x.Year)
            .ThenBy(x => x.MonthNumber)
            .ToList();
    }

}