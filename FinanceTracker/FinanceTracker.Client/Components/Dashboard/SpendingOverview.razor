@namespace FinanceTracker.Client.Components.Dashboard

<Card>

    <Header>

        <div class="card-heading">

            <div class="card-title-group">

                <h2>Spending Overview</h2>

                <p>Track your spending over time</p>

            </div>

            <select class="period-select"
                    @bind="selectedPeriod"
                    @bind:after="UpdateChart">

                <option value="month">
                    This Month
                </option>

                <option value="last">
                    Last Month
                </option>

                <option value="6months">
                    Last 6 Months
                </option>

            </select>

        </div>

    </Header>

    <ChildContent>

        <div class="chart-container">

            <RadzenChart>

                <RadzenBarSeries Data="@chartData"
                                 CategoryProperty="Month"
                                 ValueProperty="Income"
                                 Title="Income"
                                 Fill="#3B5BDB" />

                <RadzenBarSeries Data="@chartData"
                                 CategoryProperty="Month"
                                 ValueProperty="Expenses"
                                 Title="Expenses"
                                 Fill="#F43F5E" />

                <RadzenCategoryAxis Padding="20" />

                <RadzenValueAxis>
                    <RadzenGridLines Visible="true"
                                     Stroke="#E2E8F0" />
                    <RadzenAxisTitle Text="Amount (₱)" />
                </RadzenValueAxis>

                <RadzenChartTooltipOptions Shared="true" />

                <RadzenLegend Visible="true"
                              Position="LegendPosition.Bottom" />

            </RadzenChart>

        </div>
    </ChildContent>

</Card>

@code {

    [Parameter] public List<MonthlySpendingDto>? Data { get; set; }

    private string selectedPeriod = "6months";
    private List<MonthlySpendingDto> chartData = new();

    protected override void OnParametersSet()
    {
        UpdateChart();
    }

    private void UpdateChart()
    {
        if (Data is null || Data.Count == 0)
        {
            Data = new()
            {
                new MonthlySpendingDto { Month = "Jan", Income = 42000, Expenses = 28000 },
                new MonthlySpendingDto { Month = "Feb", Income = 38000, Expenses = 31000 },
                new MonthlySpendingDto { Month = "Mar", Income = 45000, Expenses = 29000 },
                new MonthlySpendingDto { Month = "Apr", Income = 41000, Expenses = 33000 },
                new MonthlySpendingDto { Month = "May", Income = 46000, Expenses = 30000 },
                new MonthlySpendingDto { Month = "Jun", Income = 44000, Expenses = 35000 },
                new MonthlySpendingDto { Month = "Jul", Income = 48500, Expenses = 32140 },
            };
        }

        chartData = selectedPeriod switch
        {
            "month" => Data.TakeLast(1).ToList(),
            "last" => Data.TakeLast(2).Take(1).ToList(),
            "6months" => Data.TakeLast(6).ToList(),
            _ => Data
        };
    }

}