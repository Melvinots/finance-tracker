@namespace FinanceTracker.Client.Components.Dashboard

<Card>

    <Header>

        <div class="card-heading">

            <div class="card-title-group">

                <h2>Spending Overview</h2>

                <p>Track your spending over time</p>

            </div>

            <select class="period-select"
                    @bind="selectedPeriod"
                    @bind:after="UpdateChart">

                <option value="@SpendingPeriod.ThisMonth">
                    This Month
                </option>

                <option value="@SpendingPeriod.LastMonth">
                    Last Month
                </option>

                <option value="@SpendingPeriod.Last6Months">
                    Last 6 Months
                </option>

            </select>

        </div>

    </Header>

    <ChildContent>

        <div class="chart-container">

            <RadzenChart>

                <RadzenBarSeries Data="@chartData"
                                 CategoryProperty="Month"
                                 ValueProperty="Income"
                                 Title="Income"
                                 Fill="#3B5BDB" />

                <RadzenBarSeries Data="@chartData"
                                 CategoryProperty="Month"
                                 ValueProperty="Expenses"
                                 Title="Expenses"
                                 Fill="#F43F5E" />

                <RadzenCategoryAxis Padding="20" />

                <RadzenValueAxis>
                    <RadzenGridLines Visible="true"
                                     Stroke="#E2E8F0" />
                    <RadzenAxisTitle Text="Amount (₱)" />
                </RadzenValueAxis>

                <RadzenChartTooltipOptions Shared="true" />

                <RadzenLegend Visible="true"
                              Position="LegendPosition.Bottom" />

            </RadzenChart>

        </div>
    </ChildContent>

</Card>

@code {

    [Parameter]
    public List<MonthlySpendingDto> Data { get; set; } = new();

    [Parameter]
    public string SelectedMonth { get; set; } = DateTime.Now.ToString("yyyy-MM");

    private SpendingPeriod selectedPeriod = SpendingPeriod.ThisMonth;

    private IEnumerable<MonthlySpendingDto> chartData =
        Enumerable.Empty<MonthlySpendingDto>();

    protected override void OnParametersSet()
    {
        UpdateChart();
    }

    private void UpdateChart()
    {
        if (string.IsNullOrWhiteSpace(SelectedMonth))
        {
            chartData = Enumerable.Empty<MonthlySpendingDto>();
            return;
        }

        var parts = SelectedMonth.Split('-');

        if (parts.Length != 2 ||
            !int.TryParse(parts[0], out var year) ||
            !int.TryParse(parts[1], out var month) ||
            month < 1 ||
            month > 12)
        {
            chartData = Enumerable.Empty<MonthlySpendingDto>();
            return;
        }

        var selectedMonth = new DateTime(year, month, 1);

        chartData = selectedPeriod switch
        {
            SpendingPeriod.ThisMonth =>
                Data.Where(x =>
                    x.Year == selectedMonth.Year &&
                    x.MonthNumber == selectedMonth.Month),

            SpendingPeriod.LastMonth =>
                GetLastMonthData(selectedMonth),

            SpendingPeriod.Last6Months =>
                GetLastSixMonthsData(selectedMonth),

            _ => Data
        };
    }

    private IEnumerable<MonthlySpendingDto> GetLastMonthData(
        DateTime selectedMonth)
    {
        var lastMonth = selectedMonth.AddMonths(-1);

        return Data.Where(x =>
            x.Year == lastMonth.Year &&
            x.MonthNumber == lastMonth.Month);
    }

    private IEnumerable<MonthlySpendingDto> GetLastSixMonthsData(
        DateTime selectedMonth)
    {
        var startMonth = selectedMonth.AddMonths(-5);

        return Data.Where(x =>
        {
            var itemMonth = new DateTime(
                x.Year,
                x.MonthNumber,
                1);

            return itemMonth >= startMonth &&
                   itemMonth <= selectedMonth;
        });
    }
}