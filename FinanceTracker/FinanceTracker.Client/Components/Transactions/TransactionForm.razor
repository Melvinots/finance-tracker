@namespace FinanceTracker.Client.Components.Transactions

<div class="modal-backdrop"
     tabindex="-1"
     @onkeydown="HandleKeyDown">

    <div class="transaction-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="transaction-modal-title">

        <div class="drag-handle"></div>

        <!-- Header -->
        <header class="modal-header">

            <div class="modal-title-group">

                <div class="modal-icon @(model.IsExpense ? "expense" : "income")">
                    <Blazicon Svg="@(Transaction is null ? Lucide.Plus : Lucide.Pencil)" />
                </div>

                <div>
                    <h2 id="transaction-modal-title">
                        @(Transaction is null ? "Add transaction" : "Edit transaction")
                    </h2>

                    <p>
                        @(Transaction is null
                            ? "Add a new transaction to your records."
                            : "Update your transaction details.")
                    </p>
                </div>

            </div>

            <button type="button"
                    class="close-button"
                    title="Close"
                    aria-label="Close"
                    disabled="@_isSubmitting"
                    @onclick="OnCancel">

                <Blazicon Svg="Lucide.X" />

            </button>

        </header>


        <EditForm Model="@model" OnValidSubmit="@HandleSubmit">

            <DataAnnotationsValidator />

            <fieldset class="form-content" disabled="@_isSubmitting">

                <!-- Type -->
                <div class="form-group">

                    <label>
                        Transaction type
                    </label>

                    <div class="type-selector">

                        <button type="button"
                                class="type-option @(model.IsExpense ? "active expense" : "")"
                                @onclick="() => model.IsExpense = true">

                            <span class="type-icon">
                                <Blazicon Svg="Lucide.ArrowDownRight" />
                            </span>

                            <span>Expense</span>

                        </button>

                        <button type="button"
                                class="type-option @(!model.IsExpense ? "active income" : "")"
                                @onclick="() => model.IsExpense = false">

                            <span class="type-icon">
                                <Blazicon Svg="Lucide.ArrowUpRight" />
                            </span>

                            <span>Income</span>

                        </button>

                    </div>

                </div>


                <!-- Amount -->
                <div class="form-group">

                    <label>
                        Amount
                    </label>

                    <div class="amount-input @(model.IsExpense ? "is-expense" : "is-income")">

                        <span class="currency-prefix">
                            @CurrencyCode
                        </span>

                        <InputNumber class="amount-field"
                                     placeholder="0.00"
                                     @bind-Value="model.Amount" />

                    </div>

                    <ValidationMessage For="@(() => model.Amount)" />

                </div>


                <!-- Description -->
                <div class="form-group">

                    <label>
                        Description
                    </label>

                    <div class="icon-input">

                        <span class="input-icon">
                            <Blazicon Svg="Lucide.FileText" />
                        </span>

                        <InputText class="description-field"
                                   placeholder="e.g. Grocery shopping"
                                   @bind-Value="model.Description" />

                    </div>

                    <ValidationMessage For="@(() => model.Description)" />

                </div>


                <!-- Category + Date -->
                <div class="form-row">

                    <div class="form-group">

                        <label for="category-field">
                            Category
                        </label>

                        <div class="compact-input">

                            <span class="compact-input-icon">
                                <Blazicon Svg="Lucide.Tag" />
                            </span>

                            <InputSelect class="category-field"
                                         @bind-Value="model.CategoryId">

                                @foreach (var category in Categories)
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }

                            </InputSelect>

                        </div>

                        <ValidationMessage For="@(() => model.CategoryId)" />

                    </div>

                    <div class="form-group">

                        <label for="date-field">
                            Date
                        </label>

                        <div class="compact-input">

                            <span class="compact-input-icon">
                                <Blazicon Svg="Lucide.Calendar" />
                            </span>

                            <InputDate class="date-field"
                                       @bind-Value="model.Date" />

                        </div>

                        <ValidationMessage For="@(() => model.Date)" />

                    </div>

                </div>

            </fieldset>


            <!-- Footer -->
            <footer class="modal-actions">

                <button type="button"
                        class="secondary-button"
                        disabled="@_isSubmitting"
                        @onclick="OnCancel">

                    Cancel

                </button>

                <button type="submit"
                        class="primary-button @(model.IsExpense ? "expense" : "income")"
                        disabled="@_isSubmitting">

                    @if (_isSubmitting)
                    {
                        <span class="button-spinner"></span>
                    }
                    else
                    {
                        <Blazicon Svg="@(Transaction is null ? Lucide.Plus : Lucide.Check)" />
                    }

                    @(Transaction is null ? "Add transaction" : "Save changes")

                </button>

            </footer>

        </EditForm>

    </div>

</div>

@code {

    [Parameter]
    public TransactionDto? Transaction { get; set; }

    [Parameter]
    public List<CategoryDto> Categories { get; set; } = new();

    [Parameter]
    public string CurrencyCode { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<SaveTransactionDto> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private SaveTransactionDto model = new();

    private bool _isSubmitting;

    protected override void OnParametersSet()
    {
        if (Transaction is null)
        {
            model = new SaveTransactionDto
            {
                Date = DateTime.Today,
                IsExpense = true
            };

            return;
        }

        model = new SaveTransactionDto
        {
            Description = Transaction.Description,
            Amount = Transaction.Amount,
            Date = Transaction.Date,
            IsExpense = Transaction.IsExpense,
            CategoryId = Transaction.CategoryId
        };
    }

    private async Task HandleSubmit()
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            await OnSave.InvokeAsync(model);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !_isSubmitting)
        {
            return OnCancel.InvokeAsync();
        }

        return Task.CompletedTask;
    }

}