@namespace FinanceTracker.Client.Components.Transactions

<div class="transaction-panel">

    @if (!Transactions.Any())
    {
        <div class="empty-state">

            <div class="empty-icon">
                <Blazicon Svg="Lucide.ReceiptText" />
            </div>

            <div class="empty-content">

                <h3>No transactions yet</h3>

                <p>
                    Your transactions will appear here once you add them.
                    Try adjusting your search or filters if you expected to see something.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="transaction-table">

            <div class="table-header">

                <span>Description</span>
                <span>Category</span>
                <span>Date</span>
                <span>Amount</span>
                <span class="actions-heading">Actions</span>

            </div>

            @foreach (var transaction in Transactions)
            {
                <TransactionRow
                    Transaction="@transaction"
                    CurrencyCode="@CurrencyCode"
                    OnEdit="@OnEdit"
                    OnDelete="@OnDelete" />
            }
             
        </div>
    }

</div>

@code {

    [Parameter]
    public IEnumerable<TransactionDto> Transactions { get; set; } = Enumerable.Empty<TransactionDto>();

    [Parameter]
    public string CurrencyCode { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<TransactionDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<TransactionDto> OnDelete { get; set; }

}
