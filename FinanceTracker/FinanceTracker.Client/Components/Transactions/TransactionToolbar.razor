@namespace FinanceTracker.Client.Components.Transactions

<div class="transaction-toolbar">

    <div class="toolbar-controls">

        <div class="search-wrapper">

            <span class="search-icon" aria-hidden="true">
                <Blazicon Svg="Lucide.Search" />
            </span>

            <input type="text"
                   class="search-input"
                   placeholder="Search transactions..."
                   aria-label="Search transactions"
                   value="@SearchTerm"
                   @oninput="HandleSearch" />

            @if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                <span class="search-status">
                    <Blazicon Svg="Lucide.Check" />
                </span>
            }

        </div>

        <div class="filter-wrapper">

            <span class="filter-icon" aria-hidden="true">
                <Blazicon Svg="Lucide.ListFilter" />
            </span>

            <select class="filter-select"
                    aria-label="Filter transactions by type"
                    value="@SelectedType"
                    @onchange="HandleTypeChanged">

                <option value="All">
                    All transactions
                </option>

                <option value="Income">
                    Income
                </option>

                <option value="Expense">
                    Expenses
                </option>

            </select>

        </div>

    </div>

</div>

@code {

    [Parameter]
    public string SearchTerm { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SearchTermChanged { get; set; }

    [Parameter]
    public string SelectedType { get; set; } = "All";

    [Parameter]
    public EventCallback<string> SelectedTypeChanged { get; set; }

    private async Task HandleSearch(ChangeEventArgs args)
    {
        await SearchTermChanged.InvokeAsync(
            args.Value?.ToString()
            ?? string.Empty);
    }

    private async Task HandleTypeChanged(ChangeEventArgs args)
    {
        await SelectedTypeChanged.InvokeAsync(
            args.Value?.ToString()
            ?? "All");
    }

}
