@namespace FinanceTracker.Client.Components.Transactions

<div class="transaction-toolbar">

    <div class="toolbar-controls">

        <div class="search-wrapper">

            <span class="search-icon" aria-hidden="true">
                <Blazicon Svg="Lucide.Search" />
            </span>

            <input type="text"
                   class="search-input"
                   placeholder="Search transactions..."
                   aria-label="Search transactions"
                   value="@SearchTerm"
                   @oninput="HandleSearchTermChanged" />

            @if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                <span class="search-status">
                    <Blazicon Svg="Lucide.Check" />
                </span>
            }

        </div>

        <div class="filter-wrapper">

            <span class="filter-icon" aria-hidden="true">
                <Blazicon Svg="Lucide.ListFilter" />
            </span>

            <select class="filter-select"
                    aria-label="Filter transactions by type"
                    @bind:get="SelectedType"
                    @bind:set="HandleSelectedTypeChanged">

                <option value="@TransactionTypeFilter.All">
                    All transactions
                </option>

                <option value="@TransactionTypeFilter.Income">
                    Income
                </option>

                <option value="@TransactionTypeFilter.Expense">
                    Expenses
                </option>

            </select>

        </div>

    </div>

</div>

@code {

    [Parameter]
    public string SearchTerm { get; set; } = string.Empty;

    [Parameter]
    public TransactionTypeFilter SelectedType { get; set; } = TransactionTypeFilter.All;

    [Parameter]
    public EventCallback<string> OnSearchTermChanged { get; set; }

    [Parameter]
    public EventCallback<TransactionTypeFilter> OnSelectedTypeChanged { get; set; }

    private async Task HandleSearchTermChanged(ChangeEventArgs args)
    {
        await OnSearchTermChanged.InvokeAsync(
            args.Value?.ToString()
            ?? string.Empty);
    }

    private async Task HandleSelectedTypeChanged(TransactionTypeFilter newType)
    {
        await OnSelectedTypeChanged.InvokeAsync(newType);
    }
}
