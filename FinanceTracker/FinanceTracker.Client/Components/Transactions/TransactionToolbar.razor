@namespace FinanceTracker.Client.Components.Transactions

<div class="transaction-toolbar">

    <div class="toolbar-controls">

        <div class="search-wrapper">

            <span class="search-icon" aria-hidden="true">
                <Blazicon Svg="Lucide.Search" />
            </span>

            <input type="text"
                   class="search-input"
                   placeholder="Search transactions..."
                   aria-label="Search transactions"
                   @bind="_searchTerm"
                   @bind:event="oninput"
                   @bind:after="NotifyFilterChanged" />

            @if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                <button type="button"
                        class="search-clear"
                        aria-label="Clear search"
                        @onclick="ClearSearch">
                    <Blazicon Svg="Lucide.X" />
                </button>
            }

        </div>

        <div class="filter-wrapper">

            <span class="filter-icon" aria-hidden="true">
                <Blazicon Svg="Lucide.ListFilter" />
            </span>

            <select class="filter-select"
                    aria-label="Filter transactions by type"
                    @bind="_selectedType"
                    @bind:after="NotifyFilterChanged">
                <option value="@TransactionTypeFilter.All">All transactions</option>
                <option value="@TransactionTypeFilter.Income">Income</option>
                <option value="@TransactionTypeFilter.Expense">Expenses</option>
            </select>

        </div>

        <div class="category-filter">

            <RadzenLabel Text="Categories"
                         Component="DropDownMultipleChips"
                         class="visually-hidden" />

            <RadzenDropDown @bind-Value="_categoryIds"
                            Change="@(_ => NotifyFilterChanged())"
                            Data="Categories"
                            TextProperty="@nameof(CategoryDto.Name)"
                            ValueProperty="@nameof(CategoryDto.Id)"
                            Multiple="true"
                            Chips="true"
                            AllowClear="true"
                            AllowFiltering="true"
                            MaxSelectedLabels="4"
                            Name="DropDownMultipleChips"
                            Placeholder="Select categories"
                            class="category-select" />

        </div>

    </div>

</div>

@code {

    [Parameter]
    public IEnumerable<CategoryDto> Categories { get; set; } = [];

    [Parameter]
    public EventCallback<TransactionFilter> OnFilterChanged { get; set; }

    private string _searchTerm = string.Empty;
    private TransactionTypeFilter _selectedType = TransactionTypeFilter.All;
    private IList<int>? _categoryIds = new List<int>();

    private Task NotifyFilterChanged()
    {
        return OnFilterChanged.InvokeAsync(
            new TransactionFilter(_searchTerm, _selectedType, _categoryIds?.ToArray() ?? []));
    }

    private async Task ClearSearch()
    {
        _searchTerm = string.Empty;
        await NotifyFilterChanged();
    }
}
