@namespace FinanceTracker.Client.Components.Transactions

<div class="transaction-row">

    <div class="transaction-description">

        <div class="transaction-icon"
             style="
            --category-color: @(Transaction.CategoryColor ?? "#64748B");
            --category-color-soft: @((Transaction.CategoryColor ?? "#64748B") + "18");
            ">

            <Blazicon Svg="@Icons.Category(Transaction.CategoryIcon)" />

        </div>

        <div class="transaction-info">

            <strong title="@Transaction.Description">
                @Transaction.Description
            </strong>

            <small>
                @(Transaction.IsExpense ? "Expense" : "Income")
            </small>

        </div>

    </div>

    <div class="transaction-category">

        <span class="category-badge"
              style="
            --category-color: @(Transaction.CategoryColor ?? "#64748B");
            --category-color-soft: @((Transaction.CategoryColor ?? "#64748B") + "18");
            ">

            <span class="category-dot"></span>

            @Transaction.CategoryName

        </span>

    </div>

    <div class="transaction-date">
        @Transaction.Date.ToString("MMM d, yyyy")
    </div>

    <div class="transaction-amount @(Transaction.IsExpense ? "expense" : "income")">

        <span class="amount-sign">
            @(Transaction.IsExpense ? "−" : "+")
        </span>

        <span class="amount-value">
            PHP @Transaction.Amount.ToString("N0")
        </span>

    </div>

    <div class="transaction-actions">

        <button class="icon-button"
                type="button"
                title="Edit transaction"
                aria-label="Edit transaction"
                @onclick="Edit">

            <Blazicon Svg="Lucide.Pencil" />

        </button>

        <button class="icon-button danger"
                type="button"
                title="Delete transaction"
                aria-label="Delete transaction"
                @onclick="Delete">

            <Blazicon Svg="Lucide.Trash2" />

        </button>

    </div>

</div>

@code {

    [Parameter]
    public TransactionDto Transaction { get; set; } = new();

    [Parameter]
    public EventCallback<TransactionDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<TransactionDto> OnDelete { get; set; }


    private Task Edit()
    {
        return OnEdit.InvokeAsync(Transaction);
    }


    private Task Delete()
    {
        return OnDelete.InvokeAsync(Transaction);
    }

}