@using Radzen

<div class="auth-form-wrapper">
    <RadzenTemplateForm TItem="LoginDto"
                        Data="@_model"
                        Submit="@HandleSubmit"
                        InvalidSubmit="@OnInvalidSubmit">

        <RadzenStack Gap="1.25rem">

            <RadzenFormField Text="Email address" Variant="@_variant">
                <ChildContent>
                    <RadzenTextBox Name="Email"
                                   @bind-Value="@_model.Email"
                                   @oninput="ClearError"
                                   AutoCompleteType="AutoCompleteType.Email" />
                </ChildContent>

                <Helper>
                    <RadzenRequiredValidator Component="Email"
                                             Text="Email is required." />

                    <RadzenEmailValidator Component="Email"
                                          Text="Enter a valid email address." />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Password" Variant="@_variant">
                <ChildContent>
                    <RadzenPassword Name="Password"
                                    @bind-Value="@_model.Password"
                                    @oninput="ClearError"
                                    AutoCompleteType="AutoCompleteType.Off"
                                    aria-label="Enter password" />
                </ChildContent>

                <Helper>
                    <RadzenRequiredValidator Component="Password"
                                             Text="Password is required." />
                </Helper>
            </RadzenFormField>

            <a class="forgot-link" href="/forgot-password">
                Forgot password?
            </a>

            <div class="auth-error-slot">
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="auth-error" role="alert">
                        <span class="error-icon">!</span>
                        <span class="error-message">@_error</span>
                    </div>
                }
            </div>

            <RadzenButton ButtonType="ButtonType.Submit"
                          class="submit-button"
                          Disabled="@_isLoading"
                          IsBusy="@_isLoading"
                          BusyText="Signing in..."
                          Text="Sign in" />

            <div class="auth-divider">
                <span>or</span>
            </div>

            <p class="auth-switch">
                Don't have an account?
                <a href="/register">Create one</a>
            </p>

        </RadzenStack>
    </RadzenTemplateForm>
</div>

@code {

    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private AuthService AuthService { get; set; } = default!;

    private Variant _variant = Variant.Outlined;
    private LoginDto _model = new();
    private bool _isLoading;
    private string? _error;

    private async Task HandleSubmit(LoginDto model)
    {
        _isLoading = true;
        _error = null;

        var result = await AuthService.LoginAsync(model);

        if (result.Success)
        {
            var destination = result.WasReactivated
                ? "/dashboard?reactivated=true"
                : "/dashboard";

            Navigation.NavigateTo(destination);
            return;
        }

        _error = result.Error;
        _isLoading = false;
    }

    private void OnInvalidSubmit()
    {
        _error = "Please fill in all required fields.";
    }

    private void ClearError()
    {
        if (_error is not null)
        {
            _error = null;
        }
    }
}