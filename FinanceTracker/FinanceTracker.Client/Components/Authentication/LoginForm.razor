@using Radzen

<div class="auth-form-wrapper">

    <RadzenTemplateForm TItem="LoginDto" Data="@_model" Submit="@HandleSubmit">

        <RadzenStack Gap="1.25rem">

            <RadzenFormField Text="Email address" Variant="Variant.Outlined" Style="width: 100%">
                <ChildContent>
                    <RadzenTextBox Name="Email"
                                   @bind-Value="@_model.Email"
                                   @oninput="ClearError"
                                   AutoCompleteType="AutoCompleteType.Email"
                                   aria-label="Email address" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="Email" Text="Email is required." />
                    <RadzenEmailValidator Component="Email" Text="Enter a valid email address." />
                </Helper>
            </RadzenFormField>

            <div class="password-group">
                <RadzenFormField Text="Password" Variant="Variant.Outlined" Style="width: 100%">
                    <ChildContent>
                        <RadzenPassword Name="Password"
                                        @bind-Value="@_model.Password"
                                        @oninput="ClearError"
                                        AutoCompleteType="AutoCompleteType.CurrentPassword"
                                        aria-label="Password" />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="Password" Text="Password is required." />
                    </Helper>
                </RadzenFormField>

                <a class="forgot-link" href="/forgot-password">Forgot password?</a>
            </div>

            <RadzenAlert Visible="@(_error is not null)"
                         AlertStyle="AlertStyle.Danger"
                         Variant="Variant.Flat"
                         Shade="Shade.Lighter"
                         Size="AlertSize.Small"
                         AllowClose="false">
                @_error
            </RadzenAlert>

            <RadzenButton ButtonType="ButtonType.Submit"
                          Text="Sign in"
                          BusyText="Signing in..."
                          IsBusy="@_isLoading"
                          Size="ButtonSize.Large"
                          Style="width: 100%" />

            <p class="auth-switch">
                Don't have an account?
                <a href="/register">Create one</a>
            </p>

        </RadzenStack>
    </RadzenTemplateForm>
</div>

@code {

    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private AuthService AuthService { get; set; } = default!;

    private readonly LoginDto _model = new();
    private bool _isLoading;
    private string? _error;

    private async Task HandleSubmit(LoginDto model)
    {
        _isLoading = true;
        _error = null;

        try
        {
            var result = await AuthService.LoginAsync(model);

            if (result.Success)
            {
                // Leave the button busy while navigating away.
                Navigation.NavigateTo(result.WasReactivated
                    ? "/dashboard?reactivated=true"
                    : "/dashboard");
                return;
            }

            _error = result.Error;
        }
        catch (Exception)
        {
            // Network or API failure: without this the button would stay busy forever.
            _error = "We couldn't sign you in. Check your connection and try again.";
        }

        _isLoading = false;
    }

    private void ClearError() => _error = null;
}
