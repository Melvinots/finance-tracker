@using Radzen

<div class="auth-form-wrapper">
    <RadzenTemplateForm TItem="LoginDto" Data="@_model" Submit="@HandleSubmit" InvalidSubmit="@OnInvalidSubmit">
        <RadzenStack Gap="1.25rem">

            <RadzenFormField Text="Email address" Variant="@_variant">
                <ChildContent>
                    <RadzenTextBox Name="Email"
                                   @bind-Value="@_model.Email"
                                   Placeholder="you@email.com"
                                   AutoCompleteType="AutoCompleteType.Email" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="Email" Text="Email is required." />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Password" Variant="@_variant">
                <ChildContent>
                    <RadzenPassword Name="Password"
                                    @bind-Value="@_model.Password"
                                    Placeholder="Enter your password"
                                    AutoCompleteType="AutoCompleteType.Off"
                                    aria-label="Enter password" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="Password" Text="Password is required." />
                </Helper>
            </RadzenFormField>

            <a class="forgot-link" href="/forgot-password">Forgot password?</a>

            <RadzenButton ButtonType="ButtonType.Submit"
                          class="submit-button"
                          Disabled="@_isLoading"
                          IsBusy="@_isLoading"
                          BusyText="Signing in..."
                          Text="Sign in" />

            <div class="auth-divider">
                <span>or</span>
            </div>

            <p class="auth-switch">
                Don't have an account?
                <a href="/register">Create one</a>
            </p>

        </RadzenStack>
    </RadzenTemplateForm>
</div>

@code {

    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private AuthService AuthService { get; set; } = default!;
    [Inject] private AuthNotificationState NotificationState { get; set; } = default!;

    private Variant _variant = Variant.Outlined;
    private LoginDto _model = new();
    private bool _isLoading;
    private string? _error;

    private async Task HandleSubmit(LoginDto model)
    {
        _isLoading = true;
        _error = null;

        var result = await AuthService.LoginAsync(model);

        if (result.Success)
        {
            NotificationState.WasReactivated = result.WasReactivated;
            Navigation.NavigateTo("/dashboard");
            return;
        }

        _error = result.Error;
        _isLoading = false;
    }

    private void OnInvalidSubmit()
    {
        _error = "Please fill in all required fields.";
    }

}