@namespace FinanceTracker.Client.Components.Authentication
@using Radzen

<div class="auth-form-wrapper">
    <RadzenTemplateForm TItem="RegisterDto"
                        Data="@_model"
                        Submit="@HandleSubmit"
                        InvalidSubmit="@OnInvalidSubmit">

        <RadzenStack Gap="1.25rem">

            <RadzenFormField Text="Full name" Variant="@_variant">
                <ChildContent>
                    <RadzenTextBox Name="FullName"
                                   @bind-Value="@_model.FullName"
                                   @oninput="ClearError"
                                   AutoCompleteType="AutoCompleteType.Name" />
                </ChildContent>

                <Helper>
                    <RadzenRequiredValidator Component="FullName"
                                             Text="Full name is required." />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Email address" Variant="@_variant">
                <ChildContent>
                    <RadzenTextBox Name="Email"
                                   @bind-Value="@_model.Email"
                                   @oninput="ClearError"
                                   AutoCompleteType="AutoCompleteType.Email" />
                </ChildContent>

                <Helper>
                    <RadzenRequiredValidator Component="Email"
                                             Text="Email is required." />

                    <RadzenEmailValidator Component="Email"
                                          Text="Enter a valid email address." />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Password" Variant="@_variant">
                <ChildContent>
                    <RadzenPassword Name="Password"
                                    @bind-Value="@_model.Password"
                                    @oninput="ClearError"
                                    AutoComplete="false" />
                </ChildContent>

                <Helper>
                    <RadzenLengthValidator Component="Password"
                                           Min="8"
                                           Text="Password must be at least 8 characters." />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Confirm password" Variant="@_variant">
                <ChildContent>
                    <RadzenPassword Name="ConfirmPassword"
                                    @bind-Value="@_model.ConfirmPassword"
                                    @oninput="ClearError"
                                    AutoComplete="false" />
                </ChildContent>

                <Helper>
                    <RadzenRequiredValidator Component="ConfirmPassword"
                                             Text="Please confirm your password." />

                    <RadzenCompareValidator Component="ConfirmPassword"
                                            Value="@_model.Password"
                                            Text="Passwords do not match." />
                </Helper>
            </RadzenFormField>

            <div class="auth-error-slot">
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="auth-error" role="alert">
                        <span class="error-icon">!</span>
                        <span class="error-message">@_error</span>
                    </div>
                }
            </div>

            <RadzenButton ButtonType="ButtonType.Submit"
                          class="submit-button"
                          Disabled="@_isLoading"
                          IsBusy="@_isLoading"
                          BusyText="Creating account..."
                          Text="Create account" />

            <p class="auth-switch">
                Already have an account?
                <a href="/login">Sign in</a>
            </p>

        </RadzenStack>
    </RadzenTemplateForm>
</div>

@code {

    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private AuthService AuthService { get; set; } = default!;

    private Variant _variant = Variant.Outlined;
    private RegisterDto _model = new();
    private bool _isLoading;
    private string? _error;

    private async Task HandleSubmit(RegisterDto model)
    {
        _isLoading = true;
        _error = null;

        var error = await AuthService.RegisterAsync(model);

        if (error is null)
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        _error = error;
        _isLoading = false;
    }

    private void OnInvalidSubmit()
    {
        _error = "Please fill in all required fields correctly.";
    }

    private void ClearError()
    {
        if (_error is not null)
        {
            _error = null;
        }
    }
}