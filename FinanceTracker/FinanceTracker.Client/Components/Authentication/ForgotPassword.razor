@page "/forgot-password"
@layout AuthLayout
@using Radzen
@inject NavigationManager Navigation

<PageTitle>Reset password — Finance Tracker</PageTitle>

<FormCard>

    <Header>

        <h2>Reset your password</h2>
        <p>Automatic password reset isn't available yet.</p>

    </Header>

    <ChildContent>

        <div class="auth-form-wrapper">

            <RadzenStack Gap="1.25rem">

                <RadzenAlert AlertStyle="AlertStyle.Info"
                             Variant="Variant.Flat"
                             Shade="Shade.Lighter"
                             Size="AlertSize.Small"
                             AllowClose="false">
                    We're still building this feature, so we can't email you a reset link.
                    @if (!string.IsNullOrWhiteSpace(SupportEmail))
                    {
                        <text> If you're locked out, contact <a href="mailto:@SupportEmail">@SupportEmail</a>.</text>
                    }
                </RadzenAlert>

                <RadzenButton Text="Back to sign in"
                              Size="ButtonSize.Large"
                              Style="width: 100%"
                              Click="@(() => Navigation.NavigateTo("/login"))" />

                <p class="auth-switch">
                    Don't have an account?
                    <a href="/register">Create one</a>
                </p>

            </RadzenStack>

        </div>

    </ChildContent>

</FormCard>

@code {
    // Set this to show a contact line in the notice; leave empty to hide it.
    private const string SupportEmail = "";
}
