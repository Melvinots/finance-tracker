@namespace FinanceTracker.Client.Components.Budgets

<div class="budget-card"
    style="--category-color: @AccentColor;
    --category-color-soft: @(AccentColor + "18");"
     @key="@($"{Budget.Id}")">

    <div class="budget-card-header">

        <div class="budget-category">

            <div class="category-icon">

                <Blazicon Svg="@Icons.Category(Budget.CategoryIcon)" />

            </div>

            <div class="category-info">

                <h3>
                    @Budget.CategoryName
                </h3>

                <span>
                    @Budget.Percentage.ToString("0")% used
                </span>

            </div>

        </div>

        @if (IsEditable)
        {
            <div class="budget-actions">

                <button class="action-button"
                        title="Edit"
                        @onclick="() => OnEdit.InvokeAsync(Budget)">
                    <Blazicon Svg="Lucide.Pencil" />
                </button>

                <button class="action-button delete"
                        title="Delete"
                        @onclick="() => OnDelete.InvokeAsync(Budget)">
                    <Blazicon Svg="Lucide.X" />
                </button>

            </div>
        }

    </div>


    <div class="budget-amounts">

        <div>
            <span class="spent">
                @CurrencyFormatter.Format(Budget.AmountSpent, CurrencyCode)
            </span>

            <span class="limit">
                / @CurrencyFormatter.Format(Budget.LimitAmount, CurrencyCode)
            </span>
        </div>

    </div>


    <div class="progress-track">

        <div class="progress-bar"
             style="--fill: @Budget.Percentage%; background-color: @Budget.CategoryColor;">
        </div>

    </div>


    <div class="budget-footer">

        <span class="@RemainingClass">
            @RemainingText
        </span>

        <span class="percentage">
            @Budget.Percentage.ToString("0")%
        </span>

    </div>

</div>

@code {

    [Parameter]
    public BudgetDto Budget { get; set; } = null!;

    [Parameter]
    public string CurrencyCode { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<BudgetDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<BudgetDto> OnDelete { get; set; }

    private bool IsEditable =>
        new DateTime(Budget.Year, Budget.Month, 1) >= new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);

    private string AccentColor =>
        string.IsNullOrWhiteSpace(Budget.CategoryColor)
            ? "var(--primary)"
            : Budget.CategoryColor;

    private string RemainingText =>
        Budget.RemainingAmount >= 0
            ? $"{CurrencyFormatter.Format(Budget.RemainingAmount, CurrencyCode)} remaining"
            : $"{CurrencyFormatter.Format(Math.Abs(Budget.RemainingAmount), CurrencyCode)} over budget";
    
    private string RemainingClass =>
        Budget.RemainingAmount < 0
            ? "remaining danger"
            : "remaining";

}