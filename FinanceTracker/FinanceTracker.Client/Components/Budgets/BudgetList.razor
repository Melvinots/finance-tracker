@namespace FinanceTracker.Client.Components.Budgets

<div class="budget-list-box">

    <div class="budget-list">

        @foreach (var budget in Budgets)
        {
            <BudgetCard Budget="@budget"
                        CurrencyCode="@CurrencyCode"
                        OnEdit="@OnEdit"
                        OnDelete="@OnDelete" />
        }

    </div>

</div>

@code {

    [Parameter]
    public IEnumerable<BudgetDto> Budgets { get; set; } = Enumerable.Empty<BudgetDto>();

    [Parameter]
    public string CurrencyCode { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<BudgetDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<BudgetDto> OnDelete { get; set; }

}