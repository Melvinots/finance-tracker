@namespace FinanceTracker.Client.Components.Budgets

<div class="budget-modal-backdrop"
     @onclick="HandleBackdropClick">

    <div class="budget-modal"
         @onclick:stopPropagation>

        <header class="budget-modal-header">

            <div class="budget-modal-title">

                <div class="budget-modal-icon">
                    <Blazicon Svg="Lucide.Wallet" />
                </div>

                <div>
                    <h2>
                        @(Budget is null ? "Add budget" : "Edit budget")
                    </h2>

                    <p>
                        @(Budget is null
                            ? "Set a spending limit for a category."
                            : "Update your spending limit.")
                    </p>
                </div>

            </div>

            <button class="budget-modal-close"
                    type="button"
                    @onclick="Cancel"
                    aria-label="Close">

                <Blazicon Svg="Lucide.X" />

            </button>

        </header>

        <EditForm Model="@_model"
                  OnValidSubmit="@HandleSubmit">

            <DataAnnotationsValidator />

            <div class="budget-modal-body">

                <div class="budget-form-group">

                    <label for="budget-category">
                        Category
                    </label>

                    <InputSelect id="budget-category"
                                 class="budget-form-control"
                                 @bind-Value="_model.CategoryId">

                        <option value="0">
                            Select category
                        </option>

                        @foreach (var category in Categories)
                        {
                            <option value="@category.Id">
                                @category.Icon @category.Name
                            </option>
                        }

                    </InputSelect>

                    <ValidationMessage For="@(() => _model.CategoryId)" />

                </div>

                <div class="budget-form-group">

                    <label for="budget-limit">
                        Monthly limit
                    </label>

                    <div class="budget-amount-input">

                        <span class="currency-prefix">₱</span>

                        <InputNumber id="budget-limit"
                                     class="budget-form-control budget-amount-field"
                                     @bind-Value="_model.LimitAmount"
                                     placeholder="0.00" />

                    </div>

                    <ValidationMessage For="@(() => _model.LimitAmount)" />

                </div>

                <div class="budget-period">

                    <div class="budget-period-info">

                        <span class="period-label">
                            Budget period
                        </span>

                        <strong>
                            @BudgetMonth.ToString("MMMM yyyy")
                        </strong>

                    </div>

                    <Blazicon Svg="Lucide.CalendarDays" />

                </div>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="budget-form-error"
                         role="alert">

                        <Blazicon Svg="Lucide.CircleAlert" />

                        <span>
                            @ErrorMessage
                        </span>

                    </div>
                }

            </div>

            <footer class="budget-modal-footer">

                <button type="button"
                        class="budget-btn-cancel"
                        @onclick="Cancel"
                        disabled="@IsLoading">

                    Cancel

                </button>

                <button type="submit"
                        class="budget-btn-save"
                        disabled="@IsLoading">

                    @if (IsLoading)
                    {
                        <span class="loading-spinner"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <Blazicon Svg="Lucide.Check" />

                        <span>
                            @(Budget is null ? "Add budget" : "Save changes")
                        </span>
                    }

                </button>

            </footer>

        </EditForm>

    </div>

</div>

@code {

    [Parameter]
    public BudgetDto? Budget { get; set; }

    [Parameter]
    public IEnumerable<CategoryDto> Categories { get; set; }
        = Enumerable.Empty<CategoryDto>();

    [Parameter]
    public int Month { get; set; }

    [Parameter]
    public int Year { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback<SaveBudgetDto> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private SaveBudgetDto _model = new();

    private DateTime BudgetMonth =>
        new(Year, Month, 1);

    protected override void OnParametersSet()
    {
        _model = new SaveBudgetDto
        {
            CategoryId = Budget?.CategoryId ?? 0,
            LimitAmount = Budget?.LimitAmount ?? 0,
            Month = Month,
            Year = Year
        };
    }

    private async Task HandleSubmit()
    {
        await OnSave.InvokeAsync(_model);
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await Cancel();
    }
}