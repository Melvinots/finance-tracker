@namespace FinanceTracker.Client.Layout
@inherits LayoutComponentBase

<PageTitle>Finance Tracker</PageTitle>

<div class="auth-layout">

    <aside class="auth-brand">
        <div class="brand-content">

            @BrandLink

            <div class="brand-copy">
                <h1>
                    Take control of
                    <span>your money.</span>
                </h1>

                <p>
                    Track your income, manage your expenses, and build
                    better financial habits with a clearer view of your money.
                </p>
            </div>

            <div class="brand-panels">
                <ul class="brand-features">
                    @foreach (var feature in _features)
                    {
                        <li>
                            <span class="feature-icon" aria-hidden="true"><Blazicon Svg="Lucide.Check" /></span>
                            @feature
                        </li>
                    }
                </ul>

                <div class="brand-stat-card" aria-hidden="true">
                    <div class="stat-card-header">
                        <span>Net savings</span>
                        <span class="stat-card-badge">+12.4%</span>
                    </div>
                    <div class="stat-card-amount">48,250.00</div>
                    <div class="stat-card-bars">
                        @foreach (var height in _bars)
                        {
                            <span style="--h: @height%"></span>
                        }
                    </div>
                </div>
            </div>

        </div>
    </aside>

    <main class="auth-content">

        <div class="mobile-brand">
            @BrandLink
        </div>

        <div class="auth-card-container">
            @Body
        </div>

        <p class="auth-footer">© @DateTime.Now.Year Finance Tracker</p>

    </main>

</div>

@code {
    private static readonly string[] _features =
    [
        "Track income and expenses",
        "Set and monitor monthly budgets",
        "Understand your spending habits"
    ];

    private static readonly int[] _bars = [40, 65, 45, 80, 60, 90, 70];

    // Rendered twice (brand panel on desktop, header on mobile) from one definition.
    private RenderFragment BrandLink => @<a class="brand" href="/">
        <span class="brand-mark"><Blazicon Svg="Lucide.Wallet" /></span>
        <span class="brand-name">Finance Tracker</span>
    </a>;
}
