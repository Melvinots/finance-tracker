@namespace FinanceTracker.Client.Layout
@inherits LayoutComponentBase

<div class="auth-layout">

    <section class="auth-brand">

        <div class="brand-grid"></div>

        <div class="brand-content">

            <a class="brand" href="/">
                <span class="brand-mark">
                    <Blazicon Svg="Lucide.Wallet" />
                </span>
                <span class="brand-name">Finance Tracker</span>
            </a>

            <div class="brand-copy">
                <span class="brand-eyebrow">PERSONAL FINANCE, SIMPLIFIED</span>

                <h1>
                    Take control of
                    <span>your money.</span>
                </h1>

                <p>
                    Track your income, manage your expenses, and build
                    better financial habits with a clearer view of your money.
                </p>
            </div>
            <div class="brand-panels">
                <div class="brand-features">
                    <div class="brand-feature">
                        <span class="feature-icon"><Blazicon Svg="Lucide.Check" /></span>
                        <span>Track income and expenses</span>
                    </div>
                    <div class="brand-feature">
                        <span class="feature-icon"><Blazicon Svg="Lucide.Check" /></span>
                        <span>Set and monitor monthly budgets</span>
                    </div>
                    <div class="brand-feature">
                        <span class="feature-icon"><Blazicon Svg="Lucide.Check" /></span>
                        <span>Understand your spending habits</span>
                    </div>
                </div>

                <!-- Floating stat card — modern fintech marketing-panel touch -->
                <div class="brand-stat-card">
                    <div class="stat-card-header">
                        <span>This month</span>
                        <span class="stat-card-badge">+12.4%</span>
                    </div>
                    <div class="stat-card-amount">₱48,250.00</div>
                    <div class="stat-card-bars">
                        <span style="--h: 40%"></span>
                        <span style="--h: 65%"></span>
                        <span style="--h: 45%"></span>
                        <span style="--h: 80%"></span>
                        <span style="--h: 60%"></span>
                        <span style="--h: 90%"></span>
                        <span style="--h: 70%"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="brand-decoration brand-decoration-one"></div>
        <div class="brand-decoration brand-decoration-two"></div>

    </section>

    <main class="auth-content">

        <div class="mobile-brand">
            <a class="brand" href="/">
                <span class="brand-mark">
                    <Blazicon Svg="Lucide.Wallet" />
                </span>
                <span class="brand-name">Finance Tracker</span>
            </a>
        </div>

        <div class="auth-card-container">
            @Body
        </div>

        <p class="auth-footer">
            © @DateTime.Now.Year Finance Tracker
        </p>

    </main>

</div>