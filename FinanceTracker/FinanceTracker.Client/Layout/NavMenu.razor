@namespace FinanceTracker.Client.Layout

@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<aside class="sidebar">

    <!-- Brand -->
    <NavLink class="sidebar-brand" href="/" Match="NavLinkMatch.All">
        <span class="brand-dot"></span>
        <span class="brand-name">FinanceTracker</span>
    </NavLink>

    <!-- Primary nav -->
    <div class="sidebar-nav">
        <span class="nav-section-label">Main</span>

        <NavLink class="nav-item" href="/dashboard">
            <span class="nav-icon">
                <Blazicon Svg="Lucide.LayoutDashboard" />
            </span>
            Dashboard
        </NavLink>

        <NavLink class="nav-item" href="/transactions">
            <span class="nav-icon">
                <Blazicon Svg="Lucide.ArrowLeftRight" />
            </span>
            Transactions
        </NavLink>

        <NavLink class="nav-item" href="/budgets">
            <span class="nav-icon">
                <Blazicon Svg="Lucide.WalletCards" />
            </span>
            Budgets
        </NavLink>

        <NavLink class="nav-item" href="/categories">
            <span class="nav-icon">
                <Blazicon Svg="Lucide.Tags" />
            </span>
            Categories
        </NavLink>

        <span class="nav-section-label">Account</span>

        <NavLink class="nav-item" href="/settings">
            <span class="nav-icon">
                <Blazicon Svg="Lucide.Settings" />
            </span>
            Settings
        </NavLink>
    </div>

    <!-- User footer -->
    <div class="sidebar-footer">
        <div class="user-row">
            <div class="user-avatar">@_initials</div>
            <div class="user-meta">
                <div class="user-name">@_fullName</div>
                <div class="user-email">@_email</div>
            </div>
        </div>
        <button class="btn-signout" @onclick="HandleLogout">← Sign out</button>
    </div>

</aside>

@code {

    private string _fullName = "";
    private string _email = "";
    private string _initials = "?";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        _fullName = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "";
        _email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
        _initials = ComputeInitials(_fullName);
    }

    private static string ComputeInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : name[..1].ToUpper();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }

}
