@page "/settings"
@attribute [Authorize]

<LoadingWrapper IsLoading="@isLoading" 
                Message="Loading your dashboard...">

    <h1>Settings</h1>
    <p>Coming soon.</p>

</LoadingWrapper>

@code {

    private bool isLoading = true;
    protected override async Task OnInitializedAsync()
    {
        // Simulate loading delay
        await Task.Delay(1000);
        isLoading = false;
    }

}
