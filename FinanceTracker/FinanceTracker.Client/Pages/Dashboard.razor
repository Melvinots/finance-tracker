@page "/dashboard"
@attribute [Authorize]

<PageContainer Title="Dashboard">

    <Subtitle>@DateTime.Now.ToString("dddd, MMMM d, yyyy")</Subtitle>

    <Actions>

        <div class="topbar-actions">

           <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.Center"
                         AlignItems="AlignItems.Center"
                         Gap="0.5rem"
                         class="period-filter">

                <RadzenDatePicker @bind-Value="@_selectedMonth"
                                  ShowDays="false"
                                  DateFormat="yyyy/MM"
                                  CurrentDateChanged="@OnCurrentDateChanged"
                                  Name="DatePickerYearMonth" />

                <RadzenLabel Text="Select Period"
                             Component="DatePickerYearMonth"
                             class="month-filter-label" />

            </RadzenStack>

        </div>

    </Actions>

    <ChildContent>

        <LoadingWrapper IsLoading="_isLoading"
                        Message="Loading your dashboard...">

            @if (_dashboard is not null)
            {
                <section class="stats-grid">

                    <StatCard Title="Total Income"
                              Value="@CurrencyFormatter.Format(_dashboard.TotalIncome, _currencyCode)"
                              Icon="@Lucide.CircleArrowDown"
                              IconBackground="#D1FAE5"
                              Variant="Positive"
                              Trend="this month" />

                    <StatCard Title="Total Expenses"
                              Value="@CurrencyFormatter.Format(_dashboard.TotalExpenses, _currencyCode)"
                              Icon="@Lucide.CircleArrowUp"
                              IconBackground="#FFE4E6"
                              Variant="Negative"
                              Trend="this month" />

                    <StatCard Title="Net Savings"
                              Value="@CurrencyFormatter.Format(_dashboard.NetSavings, _currencyCode)"
                              Icon="@Lucide.Wallet"
                              IconBackground="#EDE9FE"
                              Variant="@(_dashboard.NetSavings >= 0 ? "Positive" : "Negative")"
                              Trend="this month" />

                    <StatCard Title="Transactions"
                              Value="@_dashboard.TransactionCount.ToString()"
                              Icon="@Lucide.ReceiptText"
                              IconBackground="#FEF3C7"
                              Variant="Default"
                              Trend="This month" />

                </section>

                <section class="dashboard-grid dashboard-grid-primary">

                    <SpendingOverview Data="@_dashboard.MonthlySpending"
                                      CurrencyCode="@_currencyCode"
                                      SelectedMonth="@_selectedMonth" />

                    <CategorySpending Categories="@_dashboard.CategorySpending" />

                </section>

                <section class="dashboard-grid dashboard-grid-secondary">

                    <RecentTransactions Transactions="@_dashboard.RecentTransactions"
                                        CurrencyCode="@_currencyCode" />

                    <BudgetOverview Budgets="@_dashboard.Budgets" 
                                    CurrencyCode="@_currencyCode" />

                </section>
            }
            else
            {
                <div class="dashboard-error">

                    <div class="error-brand">
                        <span class="brand-dot"></span>
                    </div>

                    <div class="error-content">
                        <h3>Unable to load dashboard</h3>

                        <p>
                            We couldn't retrieve your dashboard data.
                            Please try again.
                        </p>
                    </div>

                    <button class="error-retry"
                            @onclick="LoadDashboardAsync">
                        Try again
                    </button>

                </div>
            }

        </LoadingWrapper>

    </ChildContent>

</PageContainer>
