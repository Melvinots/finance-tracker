@page "/settings"
@attribute [Authorize]

<div class="settings-page">

    <header class="page-header">

        <div class="page-heading">

            <div class="page-title-row">

                <div class="page-title-icon">
                    <Blazicon Svg="Lucide.Settings" />
                </div>

                <div>
                    <h1>Settings</h1>

                    <p>
                        Manage your account and FinanceTracker preferences.
                    </p>
                </div>

            </div>

        </div>

    </header>

    <div class="settings-container">

        <LoadingWrapper IsLoading="@_isLoading"
                        Message="Loading your settings...">

            <div class="settings-content">

                <!-- Profile -->
                <section class="settings-section">

                    <div class="section-heading">

                        <div class="section-heading-group">

                            <div class="section-icon">
                                <Blazicon Svg="Lucide.UserRound" />
                            </div>

                            <div>
                                <h2>Profile</h2>

                                <p>
                                    Manage your account information.
                                </p>
                            </div>

                        </div>

                    </div>

                    <div class="settings-card">

                        <div class="setting-row">

                            <div class="setting-info">

                                <span class="setting-label">
                                    Name
                                </span>

                                <span class="setting-description">
                                    Your display name.
                                </span>

                            </div>

                            <span class="setting-value">
                                @_userSettings.FullName
                            </span>

                        </div>

                        <div class="setting-divider"></div>

                        <div class="setting-row">

                            <div class="setting-info">

                                <span class="setting-label">
                                    Email
                                </span>

                                <span class="setting-description">
                                    Your account email address.
                                </span>

                            </div>

                            <span class="setting-value">
                                @_userSettings.Email
                            </span>

                        </div>

                    </div>

                </section>


                <!-- Preferences -->
                <section class="settings-section">

                    <div class="section-heading">

                        <div class="section-heading-group">

                            <div class="section-icon">
                                <Blazicon Svg="Lucide.SlidersHorizontal" />
                            </div>

                            <div>
                                <h2>Preferences</h2>

                                <p>
                                    Customize how your finances are displayed.
                                </p>
                            </div>

                        </div>
                    
                        @if (_isSaving)
                        {
                            <span class="save-status saving)">
                                
                                <Blazicon Svg="Lucide.Loader" />
                                <span>Saving…</span>
                                
                            </span>
                        }

                    </div>

                    <div class="settings-card">

                        <div class="setting-row">

                            <div class="setting-info">

                                <span class="setting-label">
                                    Currency
                                </span>

                                <span class="setting-description">
                                    Currency used throughout FinanceTracker.
                                </span>

                            </div>

                            <select class="settings-select"
                                    disabled="@_isSaving"
                                    @bind="_userSettings.Currency"
                                    @bind:after="OnPreferenceChangedAsync">

                                @foreach (var (code, displayName) in CurrencyOptions.All)
                                {
                                    <option value="@(code)"> @displayName </option>
                                }

                            </select>

                        </div>

                        <div class="setting-divider"></div>

                        <div class="setting-row">

                            <div class="setting-info">

                                <span class="setting-label">
                                    Appearance
                                </span>

                                <span class="setting-description">
                                    Choose your preferred appearance.
                                </span>

                            </div>

                            <select class="settings-select"
                                    disabled="@_isSaving"
                                    @bind="_userSettings.Appearance"
                                    @bind:after="OnPreferenceChangedAsync">

                                @foreach (var (code, displayName) in AppearanceOptions.All)
                                {
                                    <option value="@(code)">@displayName</option>
                                }

                            </select>

                        </div>

                    </div>

                </section>


                <!-- Data -->
                <section class="settings-section">

                    <div class="section-heading">

                        <div class="section-heading-group">

                            <div class="section-icon">
                                <Blazicon Svg="Lucide.Database" />
                            </div>

                            <div>
                                <h2>Data</h2>

                                <p>
                                    Manage and protect your financial data.
                                </p>
                            </div>

                        </div>

                        @if (_isExporting)
                        {
                            <span class="save-status saving">
                                
                                <Blazicon Svg="Lucide.Loader" />
                                <span>Exporting…</span>
                                
                            </span>
                        }

                    </div>

                    <div class="settings-card">

                        <div class="setting-row">

                            <div class="setting-info">

                                <span class="setting-label">
                                    Export data
                                </span>

                                <span class="setting-description">
                                    Download a copy of your financial records.
                                </span>

                            </div>

                            <button type="button"
                                    class="secondary-button"
                                    disabled="@_isExporting"
                                    @onclick="OnExportClick">

                                <Blazicon Svg="Lucide.Download" />

                                <span>Export</span>

                            </button>

                        </div>

                    </div>

                </section>


                <!-- Danger Zone -->
                <section class="settings-section">

                    <div class="section-heading">

                        <div class="section-heading-group">

                            <div class="section-icon danger">
                                <Blazicon Svg="Lucide.TriangleAlert" />
                            </div>

                            <div>
                                <h2>Danger zone</h2>

                                <p>
                                    Actions that permanently affect your account.
                                </p>
                            </div>

                        </div>

                        @if (_isDeactivating)
                        {
                            <span class="save-status saving">
                                
                                <Blazicon Svg="Lucide.Loader" />
                                <span>Deactivating…</span>
                                
                            </span>
                        }

                    </div>

                    <div class="settings-card danger-card">

                        <div class="setting-row">

                            <div class="setting-info">

                                <span class="setting-label">
                                    Deactivate account
                                </span>

                                <span class="setting-description">
                                    Temporarily disable your account. You can reactivate anytime by signing back in.
                                </span>

                            </div>

                            <button type="button"
                                    class="danger-button"
                                    disabled="@_isDeactivating"
                                    @onclick="OnDeactivateClick">

                                <Blazicon Svg="Lucide.UserX" />

                                <span>Deactivate account</span>

                            </button>

                        </div>

                    </div>

                </section>

            </div>

        </LoadingWrapper>

    </div>

</div>
