@page "/settings"

@attribute [Authorize]

<PageContainer Title="Settings">

	<Icon>

		<Blazicon Svg="Lucide.Settings" />

	</Icon>

	<Subtitle>

		Manage your account and FinanceTracker preferences.

	</Subtitle>

	<ChildContent>

		<LoadingWrapper IsLoading="@_isLoading"
			Message="Loading your settings...">

			<div class="settings-content">

				<SettingsSection Title="Profile" Description="Manage your account information.">

					<Icon><Blazicon Svg="Lucide.UserRound" /></Icon>
					<ChildContent>

						<SettingRow Label="Name"
							Description="Your display name."
							Value="@_userSettings.FullName" />
						<SettingRow Label="Email"
							Description="Your account email address."
							Value="@_userSettings.Email" />

					</ChildContent>

				</SettingsSection>

				<SettingsSection Title="Preferences"
					Description="Customize how your finances are displayed."
					StatusText="@(_isSaving ? "Saving…" : null)">
					<Icon><Blazicon Svg="Lucide.SlidersHorizontal" /></Icon>
					<ChildContent>

						<SettingRow Label="Currency" Description="Currency used throughout FinanceTracker.">

							<select class="settings-select"
								aria-label="Currency"
								disabled="@_isSaving"
								@bind="_userSettings.Currency"
								@bind:after="OnPreferenceChangedAsync">
								@foreach (var (code, displayName) in CurrencyOptions.All)
								{

									<option value="@(code)">@displayName</option>

								}

							</select>

						</SettingRow>

						<SettingRow Label="Appearance" Description="Choose your preferred appearance.">

							<select class="settings-select"
								aria-label="Appearance"
								disabled="@_isSaving"
								@bind="_userSettings.Appearance"
								@bind:after="OnPreferenceChangedAsync">
								@foreach (var (code, displayName) in AppearanceOptions.All)
								{

									<option value="@(code)">@displayName</option>

								}

							</select>

						</SettingRow>

					</ChildContent>

				</SettingsSection>

				<SettingsSection Title="Data"
					Description="Manage and protect your financial data."
					StatusText="@(_isExporting ? "Exporting…" : null)">
					<Icon><Blazicon Svg="Lucide.Database" /></Icon>
					<ChildContent>

						<SettingRow Label="Export data" Description="Download a copy of your financial records.">

							<button type="button" class="secondary-button"
								disabled="@_isExporting" @onclick="OnExportClick">
								<Blazicon Svg="Lucide.Download" />
								<span>Export</span>

							</button>

						</SettingRow>

					</ChildContent>

				</SettingsSection>

				<SettingsSection Title="Danger zone"
					Description="Actions that permanently affect your account."
					Danger="true"
					StatusText="@(_isDeactivating ? "Deactivating…" : null)">
					<Icon><Blazicon Svg="Lucide.TriangleAlert" /></Icon>
					<ChildContent>

						<SettingRow Label="Deactivate account"
							Description="Temporarily disable your account. You can reactivate anytime by signing back in.">
							<button type="button" class="danger-button"
								disabled="@_isDeactivating" @onclick="OnDeactivateClick">
								<Blazicon Svg="Lucide.UserX" />
								<span>Deactivate account</span>

							</button>

						</SettingRow>

					</ChildContent>

				</SettingsSection>

			</div>

		</LoadingWrapper>

	</ChildContent>

</PageContainer>
