@page "/transactions"
@attribute [Authorize]

<PageContainer Title="Transactions">
    
    <Icon>
        <Blazicon Svg="Lucide.ArrowLeftRight" />
    </Icon>

    <Subtitle>
        View, track, and manage your income and expenses.
    </Subtitle>

    <Actions>
        <button class="primary-button" type="button" @onclick="OpenCreateModal">
            <Blazicon Svg="Lucide.Plus" />
            <span>Add transaction</span>
        </button>
    </Actions>

    <ChildContent>

        <div class="content-header">

            <div>
                <h2>All transactions</h2>

                <p>
                    @_filteredTransactions.Count transaction@(_filteredTransactions.Count == 1 ? "" : "s")
                </p>
            </div>

            <TransactionToolbar Categories="@_categories"
                                OnFilterChanged="@HandleFilterChanged"/>

        </div>

        <LoadingWrapper IsLoading="@_isLoading"
                        Message="Loading your transactions...">

                @if (_filteredTransactions.Count > 0)
                {
                    <TransactionTable Transactions="@_filteredTransactions"
                                      CurrencyCode="@_currencyCode"
                                      OnEdit="@HandleEdit"
                                      OnDelete="@HandleDelete" />
                }
                else
                {
                    <div class="empty-transactions">
                        <p>No transactions match your filters.</p>
                    </div>

                }

        </LoadingWrapper>
    </ChildContent>

</PageContainer>

@if (_showModal)
{
    <TransactionForm Transaction="@_selectedTransaction"
                     Categories="@_categories"
                     CurrencyCode="@_currencyCode"
                     OnSave="@HandleSave"
                     OnCancel="@CloseModal" />
}