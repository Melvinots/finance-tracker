@page "/transactions"
@attribute [Authorize]

<div class="transactions-page">

    <header class="page-header">

        <div class="page-heading">

            <div class="page-title-row">

                <div class="page-title-icon">
                    <Blazicon Svg="Lucide.ArrowLeftRight" />
                </div>

                <div>
                    <h1>Transactions</h1>

                    <p>
                        View, track, and manage your income and expenses.
                    </p>
                </div>

            </div>

        </div>

        <button class="primary-button"
                type="button"
                @onclick="OpenCreateModal">

            <Blazicon Svg="Lucide.Plus" />

            <span>Add transaction</span>

        </button>

    </header>

    <LoadingWrapper IsLoading="@_isLoading"
                    Message="Loading your transactions...">

        <section class="transactions-content">

            <div class="content-header">

                <div>
                    <h2>All transactions</h2>

                    <p>
                        @_filteredTransactions.Count transaction@(_filteredTransactions.Count == 1 ? "" : "s")
                    </p>
                </div>

            </div>

            <TransactionToolbar SearchTerm="@_searchTerm"
                                OnSearchTermChanged="@HandleSearchTermChanged"
                                SelectedType="@_selectedType"
                                OnSelectedTypeChanged="@HandleSelectedTypeChanged" />

            @if (_filteredTransactions.Count > 0)
            {
                <TransactionTable Transactions="@_filteredTransactions"
                                  CurrencyCode="@_currencyCode"
                                  OnEdit="@HandleEdit"
                                  OnDelete="@HandleDelete" />
            }
            else
            {
                <div class="empty-transactions">
                    <p>No transactions match your filters.</p>
                </div>
                
            }

        </section>

    </LoadingWrapper>

</div>

@if (_showModal)
{
    <TransactionForm Transaction="@_selectedTransaction"
                     Categories="@_categories"
                     CurrencyCode="@_currencyCode"
                     OnSave="@HandleSave"
                     OnCancel="@CloseModal" />
}