@page "/budgets"
@attribute [Authorize]

<PageContainer Title="Budgets">
    
    <Icon>
        <Blazicon Svg="Lucide.WalletCards" />
    </Icon>

    <Subtitle>
        Set spending limits and keep your expenses on track.
    </Subtitle>

    <Actions>
        <div class="page-actions">
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.Center"
                         AlignItems="AlignItems.Center"
                         Gap="0.5rem"
                         class="period-filter">

                <RadzenDatePicker @bind-Value="@_selectedMonth"
                                  ShowDays="false"
                                  DateFormat="yyyy/MM"
                                  CurrentDateChanged="@OnCurrentDateChanged"
                                  Name="DatePickerYearMonth" />

            </RadzenStack>

        <button class="primary-button" type="button" @onclick="OpenCreateModal">
            <Blazicon Svg="Lucide.Plus" />
            <span>Add budget</span>
        </button>

        </div>
    </Actions>

    <ChildContent>

        <div class="content-header">

            <div>
                <h2>Budget overview</h2>

                <p>
                    @_budgets.Count
                    budget@(_budgets.Count == 1 ? "" : "s")
                </p>
            </div>

        </div>

        <LoadingWrapper IsLoading="@_isLoading"
                        Message="Loading your budgets...">

                @if (_budgets.Any())
                {
                    <BudgetList Budgets="@_budgets"
                                CurrencyCode="@_currencyCode"
                                OnEdit="@HandleEdit"
                                OnDelete="@HandleDelete" />
                }
                else
                {
                    <div class="empty-budgets">

                        <p>
                            No budgets have been created for this month.
                        </p>

                        <button class="primary-button"
                                type="button"
                                @onclick="OpenCreateModal">

                            <Blazicon Svg="Lucide.Plus" />

                            <span>Add your first budget</span>

                        </button>

                    </div>
                }

        </LoadingWrapper>
    </ChildContent>

</PageContainer>

@if (_showModal)
{
    <BudgetForm Budget="@_selectedBudget"
                Categories="@_categories"
                Year="@_selectedMonth.Year"
                Month="@_selectedMonth.Month"
                OnSave="@HandleSave"
                OnCancel="@CloseModal" />
}
