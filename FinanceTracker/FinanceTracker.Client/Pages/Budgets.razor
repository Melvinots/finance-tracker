@page "/budgets"
@attribute [Authorize]

<div class="budgets-page">

    <header class="page-header">

        <div class="page-heading">

            <div class="page-title-row">

                <div class="page-title-icon">
                    <Blazicon Svg="Lucide.WalletCards" />
                </div>

                <div>
                    <h1>Budgets</h1>

                    <p>
                        Set spending limits and keep your expenses on track.
                    </p>
                </div>

            </div>

        </div>

        <div class="page-actions">

            <select class="month-select"
                    @bind="_selectedMonth"
                    @bind:after="LoadBudgetsAsync">

                @for (int month = DateTime.Now.Month; month >= 1; month--)
                {
                    var date = new DateTime(
                        DateTime.Now.Year,
                        month,
                        1);

                    <option value="@date.ToString("yyyy-MM")">
                        @date.ToString("MMMM yyyy")
                    </option>
                }

            </select>

            <button class="primary-button"
                    type="button"
                    @onclick="OpenCreateModal">

                <Blazicon Svg="Lucide.Plus" />

                <span>Add budget</span>

            </button>

        </div>

    </header>

    <LoadingWrapper IsLoading="@_isLoading"
                    Message="Loading your budgets...">

        <section class="budgets-content">

            <div class="content-header">

                <div>
                    <h2>Budget overview</h2>

                    <p>
                        @_budgets.Count
                        @(_budgets.Count == 1 ? "budget" : "budgets")
                    </p>
                </div>

            </div>

            @if (_budgets.Any())
            {
                <BudgetList Budgets="@_budgets"
                            CurrencyCode="@_currencyCode"
                            OnEdit="@OpenEditModal"
                            OnDelete="@DeleteBudget" />
            }
            else
            {
                <div class="empty-budgets">

                    <p>
                        No budgets have been created for this month.
                    </p>

                    <button class="primary-button"
                            type="button"
                            @onclick="OpenCreateModal">

                        <Blazicon Svg="Lucide.Plus" />

                        <span>Add your first budget</span>

                    </button>

                </div>
            }

        </section>

    </LoadingWrapper>

</div>

@if (_showModal)
{
    <BudgetForm Budget="@_selectedBudget"
                Categories="@_categories"
                Year="SelectedDate.Year"
                Month="SelectedDate.Month"
                OnSave="@SaveBudget"
                OnCancel="@CloseModal" />
}
